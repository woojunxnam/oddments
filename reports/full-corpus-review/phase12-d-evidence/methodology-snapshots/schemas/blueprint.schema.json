{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woojunxnam/oddments/schemas/blueprint.schema.json",
  "title": "MPJE Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "content_version",
    "content_hash",
    "schema_version",
    "exam",
    "target",
    "target_question_count_per_mock",
    "exam_duration_minutes",
    "areas",
    "applies_to_exams_before",
    "review_date",
    "sources",
    "release_guard"
  ],
  "properties": {
    "blueprint_id": {"type": "string", "pattern": "^MPJE-MA-[A-Z0-9-]+-BLUEPRINT$"},
    "content_version": {"type": "integer", "minimum": 1},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "exam": {"type": "string", "minLength": 2},
    "target": {"type": "string", "minLength": 2},
    "target_question_count_per_mock": {"type": "integer", "minimum": 1},
    "exam_duration_minutes": {"type": "integer", "minimum": 1},
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "name", "weight_percent"],
        "properties": {
          "area": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 2},
          "weight_percent": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    },
    "applies_to_exams_before": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "release_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_reverify_after",
        "reverify_on_exam_format_change",
        "reverify_on_nabp_outline_change",
        "notes"
      ],
      "properties": {
        "must_reverify_after": {"type": "string", "format": "date"},
        "reverify_on_exam_format_change": {"type": "boolean"},
        "reverify_on_nabp_outline_change": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 2}
      }
    }
  }
}

                                 <td styleCode=" Botrule Toprule Lrule Rrule"> Orthostatic hypotension</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 0.3%</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 0.5%</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 0%</td>
                              </tr>
                              <tr>
                                 <td styleCode=" Botrule Toprule Lrule Rrule"> Akathisia</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 0.3%</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 2%</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 0%</td>

                              </tr>
                              <tr>
                                 <td styleCode=" Botrule Toprule Lrule Rrule">  Sinusitis</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule">1 </td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 2</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule">1 </td>
                              </tr>
                              <tr>
                                 <td styleCode=" Botrule Toprule Lrule Rrule">  Urinary tract infection </td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule">1</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule">3</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule">0</td>
                              </tr>
                              <tr>
                                 <td colspan="4" styleCode=" Botrule Toprule Lrule Rrule"> <content styleCode="bold">Investigations</content>
                                 </td>
                              </tr>
                              <tr>
                                 <td styleCode=" Botrule Toprule Lrule Rrule">  Blood creatine phosphokinase increased</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 1</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 2</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> &lt;1</td>
                              </tr>
                              <tr>
                                 <td styleCode=" Botrule Toprule Lrule Rrule">  Heart rate increased</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> &lt;1</td>
                                 <td align="center" styleCode=" Botrule Toprule Lrule Rrule"> 2</td>

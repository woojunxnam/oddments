    "source_text_observations_only": [
      {
        "section": "II.F(p2)",
        "quote": "Quality Related Event (QRE) means the incorrect dispensing of a prescribed medication that is received by a patient, including:"
      },
      {
        "section": "II.I(p3)",
        "quote": "Serious Injury means an injury that is life threatening, results in serious disability or death, or results in additional treatment, testing, or monitoring in a hospital or emergency department."
      }

74Z   Python2_ROOT_DIR: /opt/hostedtoolcache/Python/3.12.16/x64\n+quality\tRetain evidence\t2026-11-04T16:35:27.2221241Z   Python3_ROOT_DIR: /opt/hostedtoolcache/Python/3.12.16/x64\n+quality\tRetain evidence\t2026-11-04T16:35:27.2221630Z   LD_LIBRARY_PATH: /opt/hostedtoolcache/Python/3.12.16/x64/lib\n+quality\tRetain evidence\t2026-11-04T16:35:27.2221989Z ##[endgroup]\n+quality\tRetain evidence\t2026-11-04T16:35:27.4019405Z (node:7456) [DEP0040] DeprecationWarning: The `punycode` module is deprecated. Please use a userland alternative instead.\n+quality\tRetain evidence\t2026-11-04T16:35:27.4020975Z (Use `node --trace-deprecation ...` to show where the warning was created)\n+quality\tRetain evidence\t2026-11-04T16:35:27.4066326Z ##[warning]No files were found with the provided path: test-results/. No artifacts will be uploaded.\n+quality\tPost Run actions/checkout@v4\t﻿2026-11-04T16:35:27.4477367Z Post job cleanup.\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5607191Z [command]/usr/bin/git version\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5686688Z git version 2.56.0\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5737534Z Temporarily overriding HOME='/home/runner/work/_temp/9d177db6-86e0-4fcc-9e49-f1bace7e07de' before making global git config changes\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5739532Z Adding repository directory to the temporary git global config as a safe directory\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5746794Z [command]/usr/bin/git config --global --add safe.directory /home/runner/work/oddments/oddments\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5828312Z [command]/usr/bin/git config --local --name-only --get-regexp core\\.sshCommand\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.5888664Z [command]/usr/bin/git submodule foreach --recursive sh -c \"git config --local --name-only --get-regexp 'core\\.sshCommand' && git config --local --unset-all 'core.sshCommand' || :\"\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.6290125Z [command]/usr/bin/git config --local --name-only --get-regexp http\\.https\\:\\/\\/github\\.com\\/\\.extraheader\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.6364376Z http.https://github.com/.extraheader\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.6384105Z [command]/usr/bin/git config --local --unset-all http.https://github.com/.extraheader\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.6435770Z [command]/usr/bin/git submodule foreach --recursive sh -c \"git config --local --name-only --get-regexp 'http\\.https\\:\\/\\/github\\.com\\/\\.extraheader' && git config --local --unset-all 'http.https://github.com/.extraheader' || :\"\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.7087584Z [command]/usr/bin/git config --local --name-only --get-regexp ^includeIf\\.gitdir:\n+quality\tPost Run actions/checkout@v4\t2026-11-04T16:35:27.7148722Z [command]/usr/bin/git submodule foreach --recursive git config --local --show-origin --name-only --get-regexp remote.origin.url\n+quality\tComplete job\t﻿2026-11-04T16:35:27.7641649Z Cleaning up orphan processes\n+quality\tComplete job\t2026-11-04T16:35:27.7864213Z Terminate orphan process: pid (2688) (python)\n+quality\tComplete job\t2026-11-04T16:35:27.7970442Z ##[warning]Node.js 20 is deprecated. The following actions target Node.js 20 but are being forced to run on Node.js 24: actions/checkout@v4, actions/setup-node@v4, actions/setup-python@v5, actions/upload-artifact@v4. For more information see: https://github.blog/changelog/2025-09-19-deprecation-of-node-20-on-github-actions-runners/"},{"sha":"979f4da4d2ee9442d426d7715f0709a74586e282","filename":"reports/full-corpus-review/engineering/time-budget-practice-quality-20261104/verify_budget_only.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Ftime-budget-practice-quality-20261104%2Fverify_budget_only.py","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Ftime-budget-practice-quality-20261104%2Fverify_budget_only.py","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fengineering%2Ftime-budget-practice-quality-20261104%2Fverify_budget_only.py?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,32 @@\n+\"\"\"원본 워크플로 바이트와 정확히 한 줄의 시간 예산 변경만 있는지 검증합니다.\"\"\"\n+from pathlib import Path\n+import hashlib\n+import json\n+import subprocess\n+\n+ROOT = Path(__file__).resolve().parents[4]\n+BASE = '91a58a12cc5f12a09a0cba3a1a692e8fabfb7687'\n+WORKFLOW = '.github/workflows/practice-quality-qa.yml'\n+EVIDENCE = 'reports/full-corpus-review/engineering/time-budget-practice-quality-20261104/'\n+\n+def git(*args):\n+    return subprocess.check_output(['git', '-C', str(ROOT), *args])\n+\n+old = git('show', f'{BASE}:{WORKFLOW}')\n+new = (ROOT / WORKFLOW).read_bytes()\n+assert old.count(b'    timeout-minutes: 15\\n') == 1\n+assert new == old.replace(b'    timeout-minutes: 15\\n', b'    timeout-minutes: 120\\n', 1)\n+# Exact equality after replacing only the budget is stronger than parsed-YAML\n+# equality and preserves all existing whitespace, steps and embedded commands.\n+changed = git('diff', '--name-only', BASE, '--').decode().splitlines()\n+assert set(p for p in changed if not p.startswith(EVIDENCE)) == {WORKFLOW}, changed\n+job = json.loads((ROOT / EVIDENCE / 'job.json').read_bytes())\n+annotations = json.loads((ROOT / EVIDENCE / 'annotations.json').read_bytes())\n+assert job['head_sha'] == BASE\n+assert job['id'] == 126695337141 and job['run_id'] == 41864566412\n+assert job['conclusion'] == 'cancelled'\n+assert any(a['message'] == 'The job has exceeded the maximum execution time of 15m0s' for a in annotations)\n+obs = json.loads((ROOT / EVIDENCE / 'observation.json').read_bytes())\n+for name, expected in obs['artifacts'].items():\n+    assert hashlib.sha256((ROOT / EVIDENCE / name).read_bytes()).hexdigest() == expected\n+print(json.dumps({'result': 'PASS', 'base_sha': BASE, 'exact_budget_only_workflow_change': True, 'all_other_tracked_runtime_test_data_files_equal': True, 'original_timeout_evidence_hashes_valid': True, 'new_ci_result': 'NOT_EXECUTED'}, indent=2))"},{"sha":"d55c2231ddb069837d825e45308c2042b0105bf2","filename":"reports/full-corpus-review/engineering/time-budget-practice-quality-20261104/workflow-budget-only.patch","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Ftime-budget-practice-quality-20261104%2Fworkflow-budget-only.patch","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Ftime-budget-practice-quality-20261104%2Fworkflow-budget-only.patch","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fengineering%2Ftime-budget-practice-quality-20261104%2Fworkflow-budget-only.patch?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,13 @@\n+diff --git a/.github/workflows/practice-quality-qa.yml b/.github/workflows/practice-quality-qa.yml\n+index 470c3a2b..216c5691 100644\n+--- a/.github/workflows/practice-quality-qa.yml\n++++ b/.github/workflows/practice-quality-qa.yml\n+@@ -23,7 +23,7 @@ permissions:\n+ jobs:\n+   quality:\n+     runs-on: ubuntu-latest\n+-    timeout-minutes: 15\n++    timeout-minutes: 120\n+     steps:\n+       - uses: actions/checkout@v4\n+       - uses: actions/setup-python@v5"},{"sha":"1813fe8603b893b0d5a45dd1a92c7345db6feaeb","filename":"reports/full-corpus-review/engineering/wave10-historical-epoch-20261104/clea
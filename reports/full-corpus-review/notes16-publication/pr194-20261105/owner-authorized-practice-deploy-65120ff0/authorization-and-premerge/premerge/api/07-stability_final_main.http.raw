efusals.test_old_source_mutation_rejected) ... ok\n+test_omitted_old_record_rejected (__main__.PreservationRefusals.test_omitted_old_record_rejected) ... ok\n+test_original_metadata_date_change_rejected (__main__.PreservationRefusals.test_original_metadata_date_change_rejected) ... ok\n+test_original_source_status_clear_rejected (__main__.PreservationRefusals.test_original_source_status_clear_rejected) ... ok\n+test_original_statement_change_rejected (__main__.PreservationRefusals.test_original_statement_change_rejected) ... ok\n+test_parent_binding_change_rejected (__main__.PreservationRefusals.test_parent_binding_change_rejected) ... ok\n+test_primary_bytes_mismatch_rejected (__main__.PreservationRefusals.test_primary_bytes_mismatch_rejected) ... ok\n+test_unread_question_alignment_cannot_be_claimed (__main__.PreservationRefusals.test_unread_question_alignment_cannot_be_claimed) ... ok\n+\n+----------------------------------------------------------------------\n+Ran 17 tests in 0.098s\n+\n+OK"},{"sha":"f3a5d95c7c5f3788a6ea5b45cfd3258255be046c","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/preservation-manifest.json","status":"added","additions":268,"deletions":0,"changes":268,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fpreservation-manifest.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fpreservation-manifest.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fpreservation-manifest.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,268 @@\n+{\n+  \"schema_version\": 1,\n+  \"source_only_base_commit\": \"aeea9d9606205dd0becb7dafb78
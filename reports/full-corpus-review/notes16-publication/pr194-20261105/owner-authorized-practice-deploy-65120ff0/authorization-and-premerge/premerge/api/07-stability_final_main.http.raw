_count\": 2,\n+    \"atomic_claim_ids\": [\n+      \"NOTE-WAVE8-W3-A-3-001\",\n+      \"NOTE-WAVE8-W3-A-3-002\",\n+      \"NOTE-WAVE8-W3-A-3-003\",\n+      \"NOTE-WAVE8-W3-A-3-004\",\n+      \"NOTE-WAVE8-W3-A-3-005\",\n+      \"NOTE-WAVE8-W3-A-3-006\",\n+      \"NOTE-WAVE8-W3-A-3-007\",\n+      \"NOTE-WAVE8-W3-A-3-008\",\n+      \"NOTE-WAVE8-W3-A-3-009\",\n+      \"NOTE-WAVE8-W3-A-3-010\",\n+      \"NOTE-WAVE8-W3-A-3-011\",\n+      \"NOTE-WAVE8-W3-A-3-012\",\n+      \"NOTE-WAVE8-W3-A-3-013\",\n+      \"NOTE-WAVE8-W3-A-3-014\",\n+      \"NOTE-WAVE8-W3-A-3-015\",\n+      \"NOTE-WAVE8-W3-A-3-016\",\n+      \"NOTE-WAVE8-W3-A-3-017\",\n+      \"NOTE-WAVE8-W3-A-3-018\",\n+      \"NOTE-WAVE8-W3-A-3-019\",\n+      \"NOTE-WAVE8-W3-A-3-020\",\n+      \"NOTE-WAVE8-W3-A-3-021\",\n+      \"NOTE-WAVE8-W3-A-3-022\",\n+      \"NOTE-WAVE8-W3-A-3-023\"\n+    ],\n+    \"independent_atomic_census_review\": {\n+      \"completeness\": \"PENDING_BODY_CORRECTION_REASSESSMENT\",\n+      \"legal_status\": \"LEGAL_HOLD\",\n+      \"omission_count\": 0,\n+      \"omissions\": [],\n+      \"findings\": [\n+        {\n+          \"claim_id\": \"NOTE-WAVE8-W3-A-3-011\",\n+          \"legal_status\": \"LEGAL_HOLD\",\n+          \"finding\": \"§21의 elderly cross-reference와 현재19A14의 Older adult 표기가 다르다. 현재60세 정의와 large-print 문구는 읽었지만 용어 변경·승계의 구체 근거를 이번 범위에서 완결하지 않았다.\",\n+          \"blocker\": \"두 게시조문 용어 변경의 명시적 승계/적용 관계 추가 확인 필요. 이 한계를 전체 요청자 권리 부정으로 해석하지 않는다.\"\n+        },\n+        {\n+          \"claim_id\": \"NOTE-WAVE8-W3-A-3-019\",\n+          \"legal_status\": \"LEGAL_HOLD\",\n+          \"finding\": \"실제 배포 문구는 narcotic or controlled substance contained in schedule II or III이다. 본문의 II/III narcotic/opioid 한정 표현은 최소한 non-opioid II/III controlled substance를 빠뜨릴 수 있다.\",\n+          \"blocker\": \"본문의 opioid/narcotic-only 범위 축소를 수정/해결해야 함. 일반적인 IV narcotic 전체 해석까지 이번 finding으로 확대 확정하지 않는다.\"\n+        }\n+      ],\n+      \"claim_counts\": {\n+        \"KEEP\": 0,\n+        \"LEGAL_HOLD\": 0,\n+        \"SOURCE_BLOCKED\": 0\n+      },\n+      \"requires_review\": true,\n+      \"notice\": \"본문 교정 후보의 전문·모든 claim·기존 법규 negative·관련 derived 자료에 대한 새 non-author 검토가 대기 중입니다. 원래 KEEP는 승계하지 않으며 이 절은 daily 학습에서 제외되는 검토 보류 상태입니다.\",\n+      \"report_path\": \"reports/full-corpus-review/independent-notes/fifth-c-review.json\",\n+      \"report_sha256\": \"6f48c97fef5e585e38740719c29572ea6d68443b27ab9f4fc67ae90ac3750829\",\n+      \"result_path\": \"reports/full-corpus-review/independent-notes/review-independent-notes-3412f11d8110cc8f-result.json\",\n+      \"result_sha256\": \"fc70c5bb293b34c0a45688ae7505cfaec831292f414f79b0aad9bc9f8479e47c\",\n+      \"body_sha256\": \"e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a\",\n+      \"census_sha256\": \"3989096b1c43abfd73996e8ce99abe52699cdadd4ada8252ce7514540cf65a04\",\n+      \"actor_provenance\": {\n+        \"actor_id\": \"/root/independent_case_c\",\n+        \"session_id\": \"/root/independent_case_c\"\n+      },\n+      \"auditor_instance\": \"GPT:/root/independent_case_c:independent-legacy-20261103\",\n+      \"basis\": \"BODY_CORRECTION_PENDING_FULL_FRESH_NON_AUTHOR_REVIEW\",\n+      \"question_audit_credit\": 0,\n+      \"canonical_release_credit\": 0,\n+      \"current_review_valid\": false,\n+      \"job_id\": \"review-independent-notes-body-4c3229fb7bfb76b6\",\n+      \"review_history\": [\n+        {\n+          \"completeness\": \"COMPLETE\",\n+          \"legal_status\": \"LEGAL_HOLD\",\n+          \"omission_count\": 0,\n+          \"omissions\": [],\n+          \"findings\": [\n+            {\n+              \"claim_id\": \"NOTE-WAVE8-W3-A-3-011\",\n+              \"legal_status\": \"LEGAL_HOLD\",\n+              \"finding\": \"§21의 elderly cross-reference와 현재19A14의 Older adult 표기가 다르다. 현재60세 정의와 large-print 문구는 읽었지만 용어 변경·승계의 구체 근거를 이번 범위에서 완결하지 않았다.\",\n+              \"blocker\": \"두 게시조문 용어 변경의 명시적 승계/적용 관계 추가 확인 필요. 이 한계를 전체 요청자 권리 부정으로 해석하지 않는다.\"\n+            },\n+            {\n+              \"claim_id\": \"NOTE-WAVE8-W3-A-3-019\",\n+              \"legal_status\": \"LEGAL_HOLD\",\n+              \"finding\": \"실제 배포 문구는 narcotic or controlled substance contained in schedule II or III이다. 본문의 II/III narcotic/opioid 한정 표현은 최소한 non-opioid II/III controlled substance를 빠뜨릴 수 있다.\",\n+              \"blocker\": \"본문의 opioid/narcotic-only 범위 축소를 수정/해결해야 함. 일반적인 IV narcotic 전체 해석까지 이번 finding으로 확대 확정하지 않는다.\"\n+            }\n+          ],\n+          \"claim_counts\": {\n+            \"KEEP\": 21,\n+            \"LEGAL_HOLD\": 2,\n+            \"SOURCE_BLOCKED\": 0\n+          },\n+          \"requires_review\": true,\n+          \"notice\": \"독립 법규 검토가 보류 상태입니다. 확정된 법규 판단으로 암기하지 말고 보류 사유를 확인하세요.\",\n+          \"report_path\": \"reports/full-corpus-review/independent-notes/fifth-c-review.json\",\n+          \"report_sha256\": \"6f48c97fef5e585e38740719c29572ea6d68443b27ab9f4fc67ae90ac3750829\",\n+          \"result_path\": \"reports/full-corpus-review/independent-notes/review-independent-notes-3412f11d8110cc8f-result.json\",\n+          \"result_sha256\": \"fc70c5bb293b34c0a45688ae7505cfaec831292f414f79b0aad9bc9f8479e47c\",\n+          \"body_sha256\": \"16124c0925f7388178a9218895ea8d511436f2ca601c56f6c503e5c180e2bffc\",\n+          \"census_sha256\": \"9d2289011c30000f78eec877f311216fddcf10c6fdbbc7f166ea03700ef8d8d4\",\n+          \"actor_provenance\": {\n+            \"actor_id\": \"/root/independent_case_c\",\n+            \"session_id\": \"/root/independent_case_c\"\n+          },\n+          \"auditor_instance\": \"GPT:/root/independent_case_c:independent-legacy-20261103\",\n+          \"basis\": \"INTEGRATED_CURRENT_BINDING_CONTROLLER_ATTESTED_DECLARATION\",\n+          \"question_audit_credit\": 0,\n+          \"canonical_release_credit\": 0,\n+          \"current_review_valid\": false,\n+          \"job_id\": \"review-independent-notes-3412f11d8110cc8f\"\n+        }\n+      ],\n+      \"candidate_review_valid\": false,\n+      \"publication_blocker\": \"ROOT_SEPARATE_16_FROM_ACTUALLY_PUBLISHED_15_SNAPSHOT\"\n+    }\n+  },\n+  \"actual_effective_unit\": {\n+    \"id\": \"w3-a-3\",\n+    \"title\": \"추가 label 요건과 특별 상황\",\n+    \"body\": \"### Compounded preparation\\n\\nPharmacy가 compounded한 약에는 sterile 또는 nonsterile compounded drug preparation이라는 표시가 필요하다. Sterile 또는 complex nonsterile compounding pharmacy의 해당 label에는 pharmacy phone number와 법이 정한 staffed-hours 연락 정보 등이 추가된다. 동일 hospital의 inpatient에게 주는 경우의 예외를 일반 outpatient 처방에 확대하지 않는다. \\n\\nCompounding 표시, beyond-use date, manufacturer expiration date는 서로 다른 정보다. 제조사 제품을 단순히 다른 용기에 옮겼다는 사실만으로 모든 법적 분류가 동일해지지는 않는다. Compounding의 분류·허가·USP 상세는 Week 4에서 다룬다.\\n\\n### Large-print directions\\n\\n고령자 또는 visually impaired 환자의 해당 요청에는 directions를 inch당 10 characters를 넘지 않는 인쇄 크기로 표시하는 c.94C §21의 조건을 확인한다. 이것은 '10-point font'라는 규칙이 아니다. 글꼴 크기 단위와 characters-per-inch를 혼동하지 않는다. \\n\\n### Federal transfer warning\\n\\n해당 Schedule II·III·IV patient label에는 처방받은 환자 이외의 사람에게 약물을 넘기는 것이 연방법상 금지된다는 경고를 표시한다. 이 경고의 'transfer'는 환자 사이에서 약물을 주고받는 행위에 관한 것으로, pharmacist-to-pharmacist prescription-information transfer와 같은 의미가 아니다. Schedule VI 전체에 federal controlled-drug warning을 법적 필수사항이라고 일률적으로 붙이지 않는다. \\n\\n### Opioid/narcotic information\\n\\nc.94C §21의 해당 Schedule II·III narcotic/opioid prescription에는 Department가 정한 환자 정보 자료의 제공 의무가 연결된다. Outpatient palliative care, LTCF resident, SUD treatment 등 조문의 예외를 함께 읽는다. Pharmacy가 임의로 만든 일반 leaflet이 모든 지정 자료의 요건을 자동 충족하는 것은 아니다.\",\n+    \"origins\": [\n+      \"W3-A:3\"\n+    ],\n+    \"source_ids\": [\n+      \"src-4b5f3e5e6f00\",\n+      \"src-da8a8280d110\",\n+      \"src-97192fc77578\",\n+      \"src-386cb3e809e7\"\n+    ],\n+    \"kind\": \"source-derived\",\n+    \"source_review_date\": \"2026-10-20\",\n+    \"flags\": [],\n+    \"body_sha256\": \"16124c0925f7388178a9218895ea8d511436f2ca601c56f6c503e5c180e2bffc\"\n+  },\n+  \"selected_census\": {\n+    \"path\": \"reports/full-corpus-review/note-wave8-census.json\",\n+    \"raw_sha256\": \"9d2289011c30000f78eec877f311216fddcf10c6fdbbc7f166ea03700ef8d8d4\"\n+  },\n+  \"parent_job_id\": \"review-independent-notes-body-4c3229fb7bfb76b6\",\n+  \"parent_job_digest\": \"0d47c2ef9a60800988de3f59adc6b3205c67985bc2c21200f457a710311833d3\",\n+  \"candidate_body_sha256\": \"e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a\",\n+  \"candidate_body_is_current\": false\n+}"},{"sha":"3621a6ee29c5ff4f2457c68a25f852a4f8276a24","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/evidence/mgl11239d-retrieval.json","status":"added","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fevidence%2Fmgl11239d-retrieval.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fevidence%2Fmgl11239d-retrieval.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fevidence%2Fmgl11239d-retrieval.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,24 @@\n+{\n+  \"source_id\": \"mgl11239d\",\n+  \"official_url\": \"https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXVI/Chapter112/Section39D\",\n+  \"retrieved_at_utc\": \"2026-11-04T05:41:46.853494+00:00\",\n+  \"review_date\": \"2026-11-04\",\n+  \"normal_TLS_certificate_verification\": true,\n+  \"retrieval_method\": \"Fresh urllib.request HTTPS GET; default TLS verification and inherited proxy; no old source cache used.\",\n+  \"http_status\": 200,\n+  \"resolved_url\": \"https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXVI/Chapter112/Section39D\",\n+  \"content_type\": \"text/html; charset=utf-8\",\n+  \"last_modified\": null,\n+  \"raw_path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/evidence/mgl11239d.html\",\n+  \"raw_sha256\": \"bd50d9891c1ef7932b42e96703169cfa27cecfd4e9f608d45656f721607c61cd\",\n+  \"raw_bytes\": 82736,\n+  \"extracted_text_path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/evidence/mgl11239d.txt\",\n+  \"extracted_text_sha256\": \"84173789ecccc59d70df1efb673be55ae1901caabfbc0c7ba95667dc512c5886\",\n+  \"document_identity_and_legal_scope\": \"OFFICIAL_DOCUMENT_IDENTIFIED_AND_TARGET_PROVISIONS_DIRECTLY_READ\",\n+  \"read_at_utc\": \"2026-11-04T05:49:25.114154+00:00\",\n+  \"exact_section\": \"M.G.L. c.112 §39D(a), Compounding definition introductory conditions, clauses (1)–(3), and final commercial/FDA-approved-drug exclusion subject to clause (1).\",\n+  \"version_or_effective_date_status\": \"Current consolidated official Section39D text freshly retrieved/read on 2026-11-04. The separate commencement/amendment history of these clauses is UNKNOWN; retrieval/read dates are not legal effective dates.\",\n+  \"legal_scope_ko\": \"Statute, with express definitional scope for §39D and §§36E–42D unless the context clearly requires otherwise; no blanket repackaging exemption is inferred.\",\n+  \"source_use_scope\": \"AUTHOR_VERIFICATION_OF_NEW_ATOM_ONLY; NOT_A_FRESH_AUDIT_OF_ORIGINAL24\",\n+  \"public_raw_redistribution\": true\n+}"},{"sha":"701eeb527193e9e35cf8443cbdd9734533e3f14d","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/evidence/mgl11239d.html","status":"added","additions":1865,"deletions":0,"changes":1865,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fevidence%2Fmgl11239d.html","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fevidence%2Fmgl11239d.html","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fevidence%2Fmgl11239d.html?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,1865 @@\n+<!DOCTYPE html>\r\n+<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n+<head>\r\n+    <meta charset=\"utf-8\" />\r\n+    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n+    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->\r\n+    <meta name=\"description\" content=\"\" />\r\n+    <meta name=\"author\" content=\"\" />\r\n+\r\n+    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/Icons/apple-touch-icon.png\" />\r\n+    <link rel=\"apple-touch-icon\" sizes=\"120x120\" href=\"/Icons/apple-touch-icon-120x120.png\" />\r\n+    <link rel=\"apple-touch-icon\" sizes=\"152x152\" href=\"/Icons/apple-touch-icon-152x152.png\" />\r\n+    <link rel=\"icon\" type=\"image/png\" href=\"/Icons/favicon-32x32.png\" sizes=\"32x32\" />\r\n+    <link rel=\"icon\" type=\"image/png\" href=\"/Icons/favicon-16x16.png\" sizes=\"16x16\" />\r\n+    <link rel=\"manifest\" href=\"/Icons/manifest.json\" />\r\n+    <link rel=\"mask-icon\" href=\"/Icons/safari-pinned-tab.svg\" color=\"#0168c9\" />\r\n+    <link rel=\"shortcut icon\" href=\"/Icons/favicon.ico\" />\r\n+    <meta name=\"msapplication-config\" content=\"/Icons/browserconfig.xml\" />\r\n+    <meta name=\"theme-color\" content=\"#ffffff\" />\r\n+        <meta name=\"mg_organization\" content=\"massachusetts-legislature\" />\r\n+        <meta name=\"category\" content=\"laws-regulations\" />\r\n+                <meta name=\"mg_type\" content=\"general-law\" />\r\n+                <meta name=\"mg_key_actions\" content=\"[{ &quot;name&quot;: &quot;Search Sections within this Chapter&quot;, &quot;url&quot;: &quot;https://malegislature.gov/Laws/GeneralLaws/PartI/TitleXVI/Chapter112&quot;},\r\n+                                                   { &quot;name&quot;: &quot;Search for General Laws&quot;, &quot;url&quot;: &quot;https:\\/\\/malegislature.gov\\/Laws\\/GeneralLaws&quot;}]\" />\r\n+    <title>General Law - Part I, Title XVI, Chapter 112, Section 39D</title>\r\n+\r\n+    <!-- Core CSS -->\r\n+    <link rel=\"stylesheet\" href=\"/bundles/css/core.min.css?v=f-bNapktxVi3sZXZnZmgHGTACC2182CeG72rhZkf-1s\" />\r\n+\r\n+    <!-- Fonts -->\r\n+    <link href=\"//fonts.googleapis.com/css?family=Cinzel|Cinzel+Decorative|Raleway|Roboto&display=swap\" rel=\"stylesheet\" type=\"text/css\">\r\n+    <link rel=\"stylesheet\" href=\"/Content/font-awesome.min.css\" />\r\n+\r\n+    \r\n+    \r\n+    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->\r\n+    <!--[if lt IE 9]>\r\n+    <script src=\"//oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js\"></script>\r\n+    <script src=\"//oss.maxcdn.com/respond/1.4.2/respond.min.js\"></script>\r\n+    <![endif]-->\r\n+\r\n+        <!-- Google tag (gtag.js) -->\r\n+        <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-0RK1DK5FZ1\"></script>\r\n+        <script>\r\n+            window.dataLayer = window.dataLayer || [];\r\n+            function gtag() { dataLayer.push(arguments); }\r\n+            gtag('js', new Date());\r\n+\r\n+            gtag('config', 'G-S38HL5DE45');\r\n+        </script>\r\n+    <script src=\"/bundles/jquery.min.js\"></script>\r\n+    \r\n+    <script src=\"/bundles/virtualtour.min.js\"></script>\r\n+</head>\r\n+<body class=\"subpage\">\r\n+\r\n+    <div id=\"alertContainer\">\r\n+        <!-- Alert Banner -->\r\n+    </div>\r\n+\r\n+    <!-- Skip to Content Link -->\r\n+    <a href=\"#mainContent\" class=\"sr-only sr-only-focusable skipToContent\">Skip to Content</a>\r\n+    <div id=\"background\" style=\"background: \">\r\n+        <!--Header-->\r\n+        \r\n+<header>\r\n+    <div class=\"container\">\r\n+        \r\n+            <div class=\"visible-lg-inline weatherBox\">\r\n+    <span class=\"weatherDate\">November 04, 2026</span>\r\n+    <img id=\"wicon\" class=\"weatherIcon\" src=\"https://openweathermap.org/img/w/04n.png\" alt=\"Clouds\">\r\n+    <span class=\"weatherDivider\"> &#124; </span>\r\n+    <span class=\"weatherStats\">60&deg;F</span>\r\n+</div>\r\n+\r\n+        \r\n+        <a class=\"masthead\" href=\"/\">\r\n+            <span class=\"headNumber\">The 194th General Court of the </span>\r\n+            <span class=\"headCommonwealth\">Commonwealth of <span class=\"headMass\">Massachusetts</span></span>\r\n+        </a>\r\n+        <div class=\"utilityLinks hidden-xs dropdown navbar-right\">\r\n+                <button id=\"utilMyLegBtn\" class=\"utilityButton dropdown-toggle\" aria-controls=\"loginFlyout\" data-toggle=\"dropdown\">\r\n+                    <span class=\"fa-stack fa-lg\">\r\n+                        <span class=\"fa fa-user fa-stack-2x\"></span>\r\n+                    </span>\r\n+                    <span class=\"fa-stack mlTitle\">MyLegislature <span class=\"fa fa-caret-down\"></span></span>\r\n+                </button>\r\n+                <div id=\"loginFlyout\" class=\"dropdown-menu dropdownLogin\" aria-live=\"assertive\">\r\n+                    \r\n+<p class=\"text-center loginTitle h2\" style=\"font-family: 'Cinzel', Georgia, 'Times New Roman' , Times, serif;\">MyLegislature</p>\r\n+<form id=\"loginFlyoutForm\" class=\"form-horizontal clearfix\" role=\"form\" method=\"post\" data-ajax=\"true\" data-ajax-method=\"POST\" data-ajax-begin=\"inProgress\" data-ajax-complete=\"loginFlyoutFormOnComplete\" action=\"/Account/Login?isModal=false\">\r\n+    \r\n+<legend class=\"text-center legSignIn\">Sign in with MyLegislature Account</legend>\r\n+<span class=\"requiredFields\">* Indicates required fields</span>\r\n+<div class=\"form-group\">\r\n+    <label class=\"col-sm-3 control-label\" for=\"Email\">Email*</label>\r\n+    <div class=\"col-sm-9\">\r\n+        <input autocomplete=\"email\" class=\"form-control\" data-val=\"true\" data-val-email=\"Invalid email address.\" data-val-required=\"Email address is required.\" id=\"Email\" name=\"Email\" type=\"text\" value=\"\" />\r\n+        <span class=\"help-block field-validation-valid\" data-valmsg-for=\"Email\" data-valmsg-replace=\"true\"></span>\r\n+    </div>\r\n+</div>\r\n+<div class=\"form-group passwordField\">\r\n+    <label class=\"col-sm-3 control-label\" for=\"Password\">Password*</label>\r\n+    <div class=\"col-sm-9 clearfix\">\r\n+        <input autocomplete=\"off\" class=\"form-control\" data-val=\"true\" data-val-required=\"Password required.\" id=\"Password\" name=\"Password\" type=\"password\" />\r\n+        <span class=\"help-block field-validation-valid\" data-valmsg-for=\"Password\" data-valmsg-replace=\"true\"></span>\r\n+        \r\n+    </div>\r\n+</div>\r\n+<div class=\"col-xs-12 text-center\">\r\n+    <div class=\"clearfix\">\r\n+        <a class=\"forgotPassword\" aria-haspopup=\"true\" data-toggle=\"modal\" data-target=\"#forgotPasswordModal\" tabindex=\"0\">Forgot Password?</a>\r\n+    </div>\r\n+    <input type=\"submit\" value=\"Sign in\" class=\"btn btn-default btn-lg fnStart\"/>\r\n+    <input type=\"submit\" value=\"Signing In...\" class=\"btn btn-default btn-lg fnEnd\" style=\"display: none\" />\r\n+</div>\r\n+\r\n+<input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8DPucBtKEZpPlgOmD52veDqGPwoeYT2uMASdfLIngOj-UrNi3W0aC74JnpwMZPbLiMDBO9C0hjT0lPN53QkKBO91P_NX1s-duX3LKAb02vovW-HvHFNLLQ-KErfoxfptmve9QFvYTnj3A58iETMz67w\" /></form>\r\n+<div class=\"form-group text-center\">\r\n+    <button type=\"button\" onclick=\"window.location='/Account/ExternalLogin?provider=Facebook';\" class=\"btn btn-facebook btn-md oauthButton\"><span class=\"fa fa-facebook-official fa-fw\"></span> Sign in with Facebook</button>\r\n
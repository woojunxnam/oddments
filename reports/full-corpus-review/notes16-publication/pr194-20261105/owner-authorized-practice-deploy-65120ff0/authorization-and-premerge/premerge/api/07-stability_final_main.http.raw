annot_claim_credit[1]\" time=\"7.803\" /><testcase classname=\"tests.test_notes_held_sixteenth\" name=\"test_sixteenth_routes_old_checks_to_fixed_view_and_skips_live_old15\" time=\"8.609\" /><testcase classname=\"tests.test_notes_held_sixteenth\" name=\"test_current_counter_rejection_cannot_be_skipped_after_a_valid_old_view\" time=\"5.841\" /><testcase classname=\"tests.test_notes_held_sixteenth\" name=\"test_historical_test_adapter_never_uses_current_n1_inputs\" time=\"8.027\" /></testsuite></testsuites>\n\\ No newline at end of file"},{"sha":"a257fdb4b0c3f117d292f446e4421981c40feeff","filename":"reports/full-corpus-review/engineering/native-head-reader-20261104/mpje-native-reader-benchmark.py","status":"added","additions":39,"deletions":0,"changes":39,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-benchmark.py","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-benchmark.py","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-benchmark.py?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,39 @@\n+import argparse\n+from collections import Counter\n+import hashlib\n+import json\n+from pathlib import Path\n+import subprocess\n+import sys\n+import time\n+\n+p=argparse.ArgumentParser()\n+p.add_argument('code_root');p.add_argument('operation',choices=['metadata','migration','build'])\n+p.add_argument('output_prefix');a=p.parse_args()\n+root=Path('/workspace/mpje-pr193-qa')\n+sys.path.insert(0,str(Path(a.code_root)/'scripts'))\n+counts=Counter();original=subprocess.check_output\n+\n+def counted(command,*args,**kwargs):\n+    if command[0]=='git':counts[command[3]]+=1\n+    return original(command,*args,**kwargs)\n+\n+subprocess.check_output=counted\n+started=time.perf_counter()\n+if a.operation=='metadata':\n+    from notes_independent_metadata import load_metadata\n+    bindings={};result={'metadata':load_metadata(root,source_bindings=bindings),'source_bindings':bindings}\n+elif a.operation=='migration':\n+    import notes_held_sixteenth as held\n+    binding=json.loads((root/held.MANIFEST).read_bytes())['closure']\n+    result=held.expected_migration(root,binding)\n+else:\n+    import build_full_corpus_review as builder\n+    builder.ROOT=root;builder.OUT=root/'reports/full-corpus-review'\n+    result={str(k.relative_to(root)):v for k,v in builder.build().items()}\n+elapsed=time.perf_counter()-started\n+raw=(json.dumps(result,ensure_ascii=False,sort_keys=True,indent=2)+'\\n').encode()\n+Path(a.output_prefix+'.result.json').write_bytes(raw)\n+metrics={'code_root':a.code_root,'data_root':str(root),'data_head':original(['git','-C',str(root),'rev-parse','HEAD']).decode().strip(),'operation':a.operation,'seconds':elapsed,'git_calls':dict(counts),'result_sha256':hashlib.sha256(raw).hexdigest(),'result_bytes':len(raw)}\n+Path(a.output_prefix+'.metrics.json').write_text(json.dumps(metrics,indent=2)+'\\n')\n+print(json.dumps(metrics),flush=True)"},{"sha":"58893cc2b1eeb006ed45a27a5f5b38001589f527","filename":"reports/full-corpus-review/engineering/native-head-reader-20261104/mpje-native-reader-evidence.md","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-evidence.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-evidence.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-evidence.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,23 @@\n+Candidate: 612af5ebc252838748d5069bf2fd07f74414d2b7\n+Branch/worktree: perf/native-head-reader / /workspace/mpje-native-head-reader\n+Base: 4583316eb77eb35167fdd6b6a87b7c594b4c34cb\n+Data tree used only for reads: /workspace/mpje-pr193-qa at 2a7f76e5a2cb785a60cf78dc125bd4a7715f4f7a\n+\n+Change: extract closure.head_bytes_match; reuse the same exact-HEAD blob-index comparison in census.disk_reader and metadata.committed; enclose load_metadata in the existing head_snapshot. Preserve safe_path/output validation, raw-SHA checks, census SHA-before-HEAD ordering, record/claim/evidence validation, and existing metadata raw-byte capture cache. No verdict, migration, mtime, or guard cache was added.\n+\n+Actual native metadata comparison (metadata result plus every captured source binding):\n+- Original QA code: 227.783457376 seconds; git show 22,343; rev-parse 2; ls-tree 1.\n+- Candidate code: 89.564827569 seconds; git show 302; rev-parse 2; ls-tree 1.\n+- Wall speedup 2.5432x under concurrent workloads; git show calls reduced 98.6483%.\n+- Both result files have 483,277 bytes and SHA256 5473b1053fe0d609d2080f745b9c73bcd86019df7b3efca93e595c8bf5f3aa58; cmp returned 0.\n+- Metrics/results: /workspace/scratch/mpje-native-reader-metadata-{before,after}.{metrics,result}.json\n+- Harness: /workspace/scratch/mpje-native-reader-benchmark.py. Calls native functions; only writes its output in scratch.\n+\n+Verification:\n+- Final new regression module: 13 passed in 0.84s. Includes preserved-mtime/size disk mutation, caller-supplied altered SHA, wrong SHA, same-content symlink, HEAD advance, nested snapshot reuse, cross-root isolation, fallback exact-HEAD check, metadata result/source-binding equivalence.\n+- Existing native-focused synthetic suites: census 25, body 51, inactive 40, sibling 2, closure 32, held 17 = 167 passed.\n+- Broad run included earlier 11 new tests (178 passed overall) and 11 metadata fixture setup errors: all FileNotFoundError for immutable preimages excluded by sparse checkout. Four actual-root tests deselected. No test assertion failed.\n+- Broad run JUnit: /workspace/scratch/mpje-native-head-reader-focused.xml\n+- Candidate worktree is clean; main/QA were not edited by this candidate task.\n+\n+Native expected_migration against exact QA2a7 completed in 699.005082185s. Its complete value equals the committed revisions/notes/protected-migration-held-n1.json manifest, including all 1,721 source_bindings. Canonical result: 285,161 bytes, SHA256 f187bc788812a4cff112e4e50c19342fc2f2950b33068ec538e18052cff05918. Parent-process Git calls: rev-parse2 / ls-tree1 / show1933 (subprocess calls inside children are not counted). This exact-data-root computation invoked unmodified QA build_full_corpus_review.py and build_representative_rewrites.py children, so its full wall time is conservative and does not measure the complete integrated candidate path. Result/metrics: /workspace/scratch/mpje-native-reader-migration-after.{result,metrics}.json."},{"sha":"72839bbb14fd787ead505b26b8b9118767b1935e","filename":"reports/full-corpus-review/engineering/native-head-reader-20261104/mpje-native-reader-metadata-after.metrics.json","status":"added","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-metadata-after.metrics.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmpje-native-reader-metadata-after.metrics.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fengineering%2Fnative-head-reader-20261104%2Fmp
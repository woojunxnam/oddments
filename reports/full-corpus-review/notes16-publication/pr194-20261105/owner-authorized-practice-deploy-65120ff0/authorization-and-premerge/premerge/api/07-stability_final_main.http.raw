l":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e8f9b9bcffdb5cf8849ee97ba75b9526bd1cff67","url":"https://api.github.com/repos/woojunxnam/oddments/commits/e8f9b9bcffdb5cf8849ee97ba75b9526bd1cff67","html_url":"https://github.com/woojunxnam/oddments/commit/e8f9b9bcffdb5cf8849ee97ba75b9526bd1cff67"},{"sha":"12d1751707f917737736b1aba208b2468d054d72","url":"https://api.github.com/repos/woojunxnam/oddments/commits/12d1751707f917737736b1aba208b2468d054d72","html_url":"https://github.com/woojunxnam/oddments/commit/12d1751707f917737736b1aba208b2468d054d72"}],"stats":{"total":8226732,"additions":8221233,"deletions":5499},"files":[{"sha":"216c5691bd261fc11d8ae84207c21f09da286b53","filename":".github/workflows/practice-quality-qa.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/.github%2Fworkflows%2Fpractice-quality-qa.yml","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/.github%2Fworkflows%2Fpractice-quality-qa.yml","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/.github%2Fworkflows%2Fpractice-quality-qa.yml?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -23,7 +23,7 @@ permissions:\n jobs:\n   quality:\n     runs-on: ubuntu-latest\n-    timeout-minutes: 15\n+    timeout-minutes: 120\n     steps:\n       - uses: actions/checkout@v4\n       - uses: actions/setup-python@v5"},{"sha":"e5cbf32f9563614d400ea2dd8689250c44314215","filename":".github/workflows/representative-quality-qa.yml","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/.github%2Fworkflows%2Frepresentative-quality-qa.yml","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/.github%2Fworkflows%2Frepresentative-quality-qa.yml","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/.github%2Fworkflows%2Frepresentative-quality-qa.yml?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -43,7 +43,8 @@ jobs:\n   revision:\n     if: github.event_name != 'workflow_run'\n     runs-on: ubuntu-latest\n-    timeout-minutes: 20\n+    # Retained-source checks alone exceeded 20 minutes; retain every gate and step.\n+    timeout-minutes: 180\n     steps:\n       - uses: actions/checkout@v4\n       - uses: actions/setup-python@v5"},{"sha":"55e215ab1e0c158497956e265f027719219e7b31","filename":"conftest.py","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/conftest.py","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/conftest.py","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/conftest.py?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,5 @@\n+\"\"\"Collect live suites; verify retained publication trees through closure guards.\"\"\"\n+\n+# Published Git trees contain historical copies of the same test modules.\n+# Dedicated closure suites and the reconstructed old guards validate these bytes.\n+collect_ignore = [\"revisions/baselines\"]"},{"sha":"ad21cee192ec5bbeb7edf202819940ab6a42b272","filename":"docs/MPJE_MISSION_CHECKPOINT_2026-11-04_PR192.md","status":"added","additions":17,"deletions":0,"changes":17,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FMPJE_MISSION_CHECKPOINT_2026-11-04_PR192.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FMPJE_MISSION_CHECKPOINT_2026-11-04_PR192.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FMPJE_MISSION_CHECKPOINT_2026-11-04_PR192.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,17 @@\n+# PR192 실제 배포 완료 및 다음 검토 체크포인트\n+\n+PR192 https://github.com/woojunxnam/oddments/pull/192 는 tested `4c6380f14b516e6486c8ce8e8fdfcf75eb9ce7aa`를 병합했다. Merge `e8f9b9bcffdb5cf8849ee97ba75b9526bd1cff67`의 Git tree는 tested tree와 정확히 같다. Full pytest 1210 PASS/0 FAIL, validator 0 errors/9 warnings, artifact 0/0, 9 drift·보호 및 6 HTTP PASS, canonical 재생성 diff 0, 병합 전 QA16 SUCCESS/배포 전 production4 SKIPPED. 실제 Pages41806902060 SUCCESS 후 핵심14 assets SHA 전부 일치, public/representative/Q0012 사용자기록 브라우저3종 PASS, 병합 후 main/postpublication 11 workflow SUCCESS. 원2346 objects·키·hash·과거감사·사용자기록 보존. 실제 증거 `reports/full-corpus-review/pr192-publication-evidence/closure.json`.\n+\n+공개2349/author2349(100%), 고유 독립원문실독1683/정답판정1633(69.52%, HOLD·AMBIG 포함)/NOT_ASSESSED50, 현실성PASS680. 기본 연습298→202, 실제 부정96 제외. 남은202 current full-record hash KEEP/YES/PASS 확인. Canonical397/guide40, 새canonical release0. 새SATA RW0081–83은 formal current-ID author/독립KEEP·YES·PASS 완료이나 archive-only. 기존EXP0351/0367/0383 HOLD 지속. 이번 세 대체문항 공개3/3은 제한된 실질교정 실적이며 전체 결함교정률100%가 아니다.\n+\n+공개 PR192 노트79/306(25.82%)와 후속branch의98/306(32.03%)을 구분한다. 후속 actual notes32/33 및 census-v2 notes34/35/36까지 순차INTEGRATED. 현행99 processed, 98 COMPLETE, 1 OMISSIONS_FOUND(return-pathways의 일반package label 갱신); 단위68KEEP/19HOLD/12SB, 2122명제2068KEEP/27HOLD/27SB. Author열거6993은 독립완료가 아니다. 원OPEN4 및 M본문 보존. 누락 단위에는 새census-v3 원자명제와 별도 전체 독립재평가가 필요하다. 미활성 N1 w3-a-3의25명제 후보는 native 등록/새독립감사/actual published15 closure/16 승인 전까지 current credit0. 기존 claim011 HOLD를 positive로 덮지 않는다.\n+\n+다음 독립원장 자동계획: branch `mission/mpje-archive-wave11`, prepared head `f42efa6c11e580befb3dd388bd8c3e0eaf0a3b55`, native sequence38–41, 40개씩160개(default0). 새 실제 세션 /root/independent_wave11_a/b/c/d, 자기격리worktree/visible-whitelist inputs/retained context snapshot. root만 queue/공유생성물 쓰기 및 순서통합. 실제 원문·모든보기·key·한국어설명, current 공식primary, 별도realism 검토. Git push HTTP500으로 Git Data API를 통해 원커밋·tree SHA를 동일하게 저장하고 ref 재조회로 확인했다. 실패push를 성공이라고 기록하지 않는다.\n+\n+B의 notes35 실제세션이 두 질문의 숨은truth를 우발적으로 보았으므로 MA-CASE0649/MA-EXP0781 whole-key fresh credit 금지. `census-v2-b-actual-exposure-limitations.json`과 원보고서의 실제 scope를 보존하며 같은 세션을 새이름으로 재배정하지 않는다. Notes credit과 질문credit을 혼합하지 않는다.\n+\n+교정10개 draft는 별도G author/F final검토 positive이나 public-ID/native author와 current-ID 독립QA가 아직 없으므로 원10 HOLD·신규공개0. Source-only compiler/16guard 작업은 실제등록·제품활성화·출시를 의미하지 않는다. 현재 source-bound rootbranch에는 published15 고정노트31과 후속notes36의 차이로 old15 drift가 의도적으로 차단된다. 이를 면제하지 말고 bounded16 actual closure를 완성해야 한다. 다음 출시에는 전체pytest/정규재생성/GitHubCI/실제public검증을 새후보에 다시 수행한다.\n+\n+전체임무는 미완료다. 독립미검토666개와 정답미판정50개, 미완료 노트208단위(이 중 현재명제누락1단위), 법적차단/불명확/HOLD와 실제교정 후 current-hash 새독립검증이 남았다. 모든Known default 부정은 즉시안전보류한다. 신규 완결을 미리 계산하지 않는다. 실제Safari/물리기기/psychometric검사는 NOT_RUN.\n+\n+실제 추가체크포인트: source-only inactive-census 경로165PASS 후 현재 M notes36 ledger snapshot을 보존하고 native notes37 `review-independent-notes-inactive-census-fcfb1af49389eb20`을 QUEUED로 등록했다. 이는 비활성N1/25명제 별도 fresh 검토 대기이며 현재본문·coverage·legal·release credit은0이다. 실제 원결과127개 anchor `22fd115dc9f00b7629789458b95c09aeeadf9917`은 prepared160/보완draft를 완료실적으로 세지 않는다."},{"sha":"9fa6e360be291f707befc625b9d3f7bd1e0ef034","filename":"docs/NOTES_HELD_N1_ACTUAL_ACTIVATION_RUNBOOK.md","status":"added","additions":137,"deletions":0,"changes":137,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FNOTES_HELD_N1_ACTUAL_ACTIVATION_RUNBOOK.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FNOTES_HELD_N1_ACTUAL_ACTIVATION_RUNBOOK.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FNOTES_HELD_N1_ACTUAL_ACTIVATION_RUNBOOK.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,137 @@\n+# 실제 N1 held 활성화의 root 실행 순서\n+\n+이 문서는 `/root/notes16_engineering`의 read-only 사전점검과 실행 안내다.\n+활성화 source나 migration manifest를 생성·승인하지 않는다. 필드는 실제 helper의\n+성공 출력에서만 얻으며, 이 문서의 이름이나 예시로 실제 결과를 대신하지 않는다.\n+\n+## 확인된 실제 입력과 현재 blocker\n+\n+사전점검 HEAD는 `858c9edef81e51656fd2d3cfd9db934833d9f504`다. 대응 원증거는\n+`reports/full-corpus-review/notes16-activation-preflight/actual-source-preflight-858c9ede.json`에 있다.\n+\n+- Native37의 실제 fresh25는 INTEGRATED/COMPLETE/LEGAL_HOLD,25 claim/omissions0이다.\n+  원011의 LEGAL_HOLD와 상속 blocker가 실제 queue/report/envelope에 그대로 있다.\n+- Native34 `w3-a-15`는 COMPLETE/SOURCE_BLOCKED,14 claim이다.\n+- Native35 `w3-a-16`은 COMPLETE/LEGAL_HOLD,27 claim이다.\n+- Return-pathways의 latest38은 당시 LEASED다. 이후 실제 감사가 발견한 추가 누락과\n+  법규 차단을 새 author census와 별도 fresh 감사로 처리한 최종 job이 필요하다.\n+  이 문서는 미래 job ID·최종 claim수·COMPLETE를 예측하지 않는다.\n+- 활성 edition은 M(`2026-11-03.emergency-kit.1`)이며 source/manifest 파일과 해당 승인표는 비어 있다.\n+  진단 전후 queue/ledger/guide/공개 Markdown/원14·15 SHA는 같았다.\n+- Root의 published15 verify-v2는 `docs/REVIEW_QUEUE.md`의 old preimage가 빠져\n+  SOURCE_BLOCKED로 종료했다. 기존 closure를 넓게 허용하지 말고 실제 공개 blob을\n+  보존하는 새 immutable closure revision을 준비해야 한다.\n+\n+## 1. 실제 최종 native source를 먼저 확정\n+\n+Root는 pending note job을 계약에 따라 통합하고 return-pathways의 실제 최신\n+census/report/envelope/공식 근거를 확정한다. `census.latest_jobs(state)`가 선택한\n+네 단위 모두 INTEGRATED이고 `validate_job`을 통과해야 한다. Return의 실제\n+OMISSIONS_FOUND/LEGAL_HOLD/SOURCE_BLOCKED를 긍정 판정으로 바꾸지 않는다.\n+N1/25 자체는 COMPLETE/omissions0이어야 하고011은 반드시 LEGAL_HOLD여야 한다.\n+\n+원장을 현재 M 상태에서 재생성하고 warning/selection도 현재 결과에 맞게 갱신한다.\n+각 단계의 source/generated 변경을 검토·커밋한다. 공유 파일은 root만 갱신한다.\n+`build_representative_rewrites.py`는 현재 archive-warning sourceSHA를 wrapper의\n+단 하나의 허용 입력에 결박한다. 모든 question/key/source/다른 metadata는 원본과 같다.\n+\n+## 2. Source용 실제 공개15 closure를 새 revision으로 보존\n+\n+아래 `notes16_source_closure` 변수는 root가 새로 선택한 **고유한 실제 출력 경로**다.\n+기존 closure를 덮어쓰지 않는다. 파일명을 정했다는 사실은 승인이나 검증이 아니다.\n+`notes16_final_closure`도 뒤 단계에서 별도 실제 고유 경로를 정한다.\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/notes_published15_closure.py \\\n+  --actor /root --prepare \\\n+  --published-commit e8f9b9bcffdb5cf8849ee97ba75b9526bd1cff67 \\\n+  --receipt reports/full-corpus-review/notes16-publication/pr192-20261104-resume/receipt-root-verified.json \\\n+  --output \"$notes16_source_closure\"\n+```\n+\n+Root는 생성된 full-source manifest와 모든 old preimage를 검토·커밋한다. 실제\n+path/rawSHA 및 공개 commit/tree를 `notes_published15_closure.APPROVED_CLOSURES`에\n+고정·커밋한 뒤 아래 실제 검사를 통과해야 한다. 실행 중 source HEAD를 바꾸지 않는다.\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/notes_published15_closure.py \\\n+  --binding \"$notes16_source_closure\" --verify-old\n+```\n+\n+이 검사는 원 공개15 전체 tree를 원바이트로 재구성해 원14·15와1781 보호를 실행한다.\n+새 파일이 이후 바뀌어 old preimage가 더 필요하면 새로운 revision을 준비한다.\n+\n+## 3. 실제 source proposal을 검토하고 별도로 결박\n+\n+`--propose-source`에는 actor option이 없고 read-only다. 실제 latest native job과\n+승인된 공개 closure를 읽어 계약을 검증한다. 성공 출력만 별도 임시 파일로 보존한다.\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/notes_held_sixteenth.py \\\n+  --propose-source --closure \"$notes16_source_closure\" \\\n+  > /workspace/scratch/held-n1-source-proposal.json\n+```\n+\n+Root는 실제 출력의 N37 report/envelope/actor, latest G3 IDs, source closure와\n+zero-credit 필드를 확인한다. 성공 출력으로만 `revisions/notes/held-n1-activation.json`을\n+만든다. 실제 source path/rawSHA를 키로 하는 `APPROVED_ACTIVATION_SOURCES`의 값은\n+이 출력의 **실제** `closure`와 `review`다. Source 파일과 해당 explicit binding을\n+함께 검토·커밋한다. 작성 중 불완전한 source 파일을 둔 채 generator를 실행하지 않는다.\n+허용표만 미리 추가하거나 다른 시점의 proposal/미래 job으로 채우지 않는다.\n+\n+이 승인으로 loader가 정확히 M의 `w3-a-3` 한 단위를 N1으로 합성할 수 있지만,\n+이는 법규 PASS나 공개 승인이 아니다. 원 `notes/guide.json` 또는 M 역사파일을\n+수정하지 않는다. SOURCE가 없을 때 기존 M을 반환하고, unapproved/stale source는 실패한다.\n+\n+## 4. 실제 held 결과를 순서대로 재생성·커밋\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/build_full_corpus_review.py\n+```\n+\n+먼저 새 ledger/current bindings를 검토·커밋한다. 새 활성 N1/25와 실제 통합 보고서의\n+body/census/claim binding이 일치할 때만 해당 completeness가 계산된다. 그 후:\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/build_ultimate_notes.py\n+/workspace/mpje-venv/bin/python scripts/build_exam_study.py\n+/workspace/mpje-venv/bin/python scripts/build_refresh.py\n+```\n+\n+Root는 실제 Markdown/build와 기타 생성물을 검토·커밋한다. `w3-a-3`의\n+`LEGAL_HOLD`, `requires_review`, notice, daily 제외와 original011 blocker를 확인한다.\n+다른305 본문 record, 원 질문/정답/이력, 원14·15 및 보호정책을 보존한다.\n+\n+## 5. Final output용 closure와 실제 migration을 별도로 결박\n+\n+N1 출력/진척/카드/등록원장 변경 후에는 source closure에 없던 old preimage가 생길 수 있다.\n+2단계와 같은 실제 published commit·receipt로 `notes16_final_closure`를 새로 prepare하고,\n+preimages/manifest를 커밋·명시 결박·verify-old 한다. Source closure와 공개 commit/tree/15 SHA가\n+같아야 한다. 원 source closure는 보존하며 새 final closure로 덮어쓰지 않는다.\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/notes_held_sixteenth.py \\\n+  --propose-migration --closure \"$notes16_final_closure\" \\\n+  > /workspace/scratch/held-n1-migration-proposal.json\n+```\n+\n+이 helper는 실제 current N1 생성물, 최신25·G3·Q queue, current counters와 모든 sourceSHA를\n+검사한다. 성공 출력만 `revisions/notes/protected-migration-held-n1.json`으로 보존하고\n+실제 path/rawSHA와 출력의 실제 `closure`를 `APPROVED_MIGRATIONS`에 고정·커밋한다.\n+Source 승인만으로 이 단계를 대체할 수 없다. 미래 결과를 manifest skeleton으로 채우지 않는다.\n+\n+```bash\n+/workspace/mpje-venv/bin/python scripts/notes_held_sixteenth.py --check\n+/workspace/mpje-venv/bin/python scripts/verify_representative_protected.py --check\n+```\n+\n+이후 관련 validators, full pytest, 정규 artifact 생성과 재생성 diff0, exact-head GitHub CI를\n+현재 후보에 대해 실행한다. 테스트 fixture PASS는 실제 source/output/publication 검증을\n+대신하지 않는다. 새 note/Q 결과나 source 변경으로 source binding이 바뀌면 기존16을\n+재사용하지 않고 다시 실제 결과에 결박한다. 모든 release gate 통과 전 병합·배포하지 않는다.\n+\n+## 현재 사전점검의 한계\n+\n+이 문서와 JSON은 HEAD858c9ede의 실제 source read-only 확인이다. 최종 return census\n+감사, N1 활성화, final16, full QA/CI 및 새 Pages 검증은 수행하지 않았다. 현재 활성 M과\n+public Markdown은 그대로다. 원011 HOLD와 sibling HOLD/SOURCE_BLOCKED를 유지한다."},{"sha":"f6f07ccb11ac9bd012712c28639f2c0725ff5941","filename":"docs/NOTES_HELD_SIXTEENTH_SOURCE.md","status":"added","additions":157,"deletions":0,"changes":157,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FNOTES_HELD_SIXTEENTH_SOURCE.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FNOTES_HELD_SIXTEENTH_SOURCE.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FNOTES_HELD_SIXTEENTH_SOURCE.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,157 @@\n+# N1 held-note의16번째 source gate — 아직 비활성\n+\n+이 코드는 실제15 공개와 실제 B의25개 claim 전수 검토가 없으면 차단된다.\n+`APPROVED_CLOSURES`, `APPROVED_ACTIVATION_SOURCES`, `APPROVED_MIGRATIONS`는 모두 빈\n+목록이다. 실제 source/activation/migration JSON은 작성하지 않았다. 새 loader hook은\n+승인된 source 파일이 없으면 기존 M을 그대로 반환한다. PR192의 미공개15에 이\n+engineering을 섞거나 root queue/generated/body를 worker가 수정하는 작업이 아니다.\n+\n+## 역사305와 적법한 sibling 진화\n+\n+기존 C31 body의 `validate_registered`는 등록 당시305 binding을 과거 증거로 보존하고\n+현재 sibling census와 매번 같도록 요구하지 않는다. 원687 inactive successor의\n+`current305 == registration305` 검사는 실제로 후속 적법 version도 막았다.\n+3절을 먼저 통합한 후 최신 실제 ledger snapshot으로25를 등록하면 당장은 해결된다.\n+하지만 앞으로의 전수 보완도 가능해야 하므로 forward native chain을 별도로 증명한다.\n+\n+원 snapshot·C31/parent·원 claim/source/hash/negative는 그대로 둔다. 다른 절의 변화는\n+실제 등록된 `CENSUS_ONLY_OMISSION_REASSESSMENT` record에서 원 binding→현재 binding으로\n+이어지고 body SHA가 같을 때만 허용한다. 모든 원명제·carry·source bytes·등록 event를\n+재검증한다. 미통합 author version은 처리 credit0이며 INTEGRATED는 실제 HEAD의\n+report/envelope/authority bytes와 통합 event도 검증한다. Claim 이후 과거 binding으로\n+되돌리거나 임의 row/census/source/body를 바꾸면 실패한다. 역사 body record를 지우거나\n+305 원 snapshot을 새 수치로 덮을 필요가 없다. Synthetic 실제 controller 시뮬레이션은\n+3절→25와25→3절 두 순서 모두 검증했다. 이는 실제 등록·법규 감사 실적이 아니다.\n+\n+## 실제 공개15 closure\n+\n+`notes_published15_closure.py`의 preparation만 과거 Git blob을 읽는다. 실제 main merge\n+commit과 tested tree가 같고, 커밋된 원 GitHub PR/commit/QA/Pages JSON 및 공개 asset\n+payload가 있어야 한다. QA는 실제 tested와 main SHA에서 success여야 하고 Pages는\n+실제 main SHA에서 success여야 한다. 적어도 공개 Markdown/build의 실제 HTTPS200\n+payload SHA가 그 published tree와 같아야 한다. Proposed 후보나200 error page,\n+실패한 CI, 다른 tree/URL/TLS 선언은 근거가 아니다. Controller의 보존·출처 선언과\n+바이트 결박을 확인하는 것이며 원격 신원/실독을 암호학적으로 인증한다는 뜻은 아니다.\n+\n+Receipt는 `reports/full-corpus-review/notes16-publication/` 아래 새 경로에 둔다.\n+최상위는 schema1/status `ACTUAL_PUBLISHED_VERIFIED`/controller `/root`/repository\n+`woojunxnam/oddments`, 실제 published/tested commit와 tree, pull_number 및 원 payload\n+bindings를 가진다. `pull`, `published_commit_payload`, `tested_commit_payload`,\n+`ci_runs[]`, `pages_run`, `public_assets[].payload` 각각의 binding은 다음 정확한 키다.\n+\n+```text\n+path, raw_sha256, official_url, http_status, tls_verified, retrieved_at_utc\n+```\n+\n+모든 payload는 원바이트로 먼저 보존·커밋한다. Wrapper는 실제 확보한 상태·TLS·UTC\n+timestamp만 기록한다. GitHub JSON은 공식 `api.github.com/repos/woojunxnam/oddments/`\n+endpoint의 실제 PR/commit/actions run이며 assets는 실제 GitHub Pages origin이다.\n+Receipt 자체는 `{path, raw_sha256}`로 결박한다. 실제 값이 없으면 template의 가상값으로\n+채우지 말고 BLOCKED로 둔다. 이 branch에는 실제 receipt를 만들지 않았다.\n+\n+Preparation은 전체 published tracked tree의 각 path/mode/Git-blob/SHA256과 original1781\n+현재 raw SHA를 pin한다. 현재 HEAD 바이트가 같으면 이를 재사용하고 달라졌거나\n+없어진 path만 `revisions/baselines/notes16-published15/<actual-published-commit>/<old-path>`에\n+원 Git blob 그대로 보존한다. 기존 snapshot을 다른 바이트로 덮지 않는다.\n+\n+```sh\n+python scripts/notes_published15_closure.py --actor /root --prepare \\\n+  --published-commit ACTUAL_MERGED_40SHA \\\n+  --receipt reports/full-corpus-review/notes16-publication/ACTUAL/receipt.json \\\n+  --output revisions/notes/published15-closures/ACTUAL-v1.json\n+```\n+\n+실제 root controller worktree와 커밋된 실제 receipt가 필요하다. 결과는 승인 전 source\n+보존 proposal이며 activation이 아니다. 새 파일을 검토·커밋한 후 실제 path/rawSHA와\n+published commit/tree를 코드의 explicit closure 목록에 고정한다. 공개 후 source가 더\n+변해 새 old-preimage가 필요하면 실제 pub blob에서 새 immutable closure revision을\n+준비한다. 원 closure/preimage는 보존한다. Runtime은 누락 preimage를 current 파일로\n+대체하거나 원 Git object에서 몰래 보충하지 않고 SOURCE_BLOCKED로 실패한다.\n+\n+필요하면 preparation에 `--retain-all`을 추가해 현재 같은 파일까지 실제 published\n+Git blob 원바이트로 전부 보존할 수 있다. Python API는 `prepare(..., retain_all=True)`와\n+`write_preparation(..., retain_all=True)`를 제공하며 기본값은 기존 changed-only 동작이다.\n+이 옵션도 기존 경로의 서로 다른 snapshot을 덮지 않으므로 새 closure output 경로가\n+필요하다. Root controller·실제 publication receipt·현재 같은 바이트의 HEAD 검증을\n+계속 요구한다. 나중에 적법하게 변경한 helper/test의 과거 바이트를 복원할 때 유용하지만,\n+live1781·원14/15·4정책·bank wrapper의 기존 narrow guard는 그대로 적용한다.\n+전체 preimage 보존은 closure 승인·N1 활성화·현재 검증 면제나 출시 승인이 아니다.\n+\n+Runtime은 현재 HEAD와 보존 preimage만으로 전체 원 tree를 임시 read-only view에\n+재구성하고 Git tree SHA가 실제 published tree와 같은지 확인한다. 임시 새 HEAD는\n+바이트 조회용이며 원 published commit을 위조하거나 옛 Git object를 요구하지 않는다.\n+원 old verifier/old scripts를 그 view의 별도 Python process에서 실행한다. 따라서 old15/14가\n+현재 N1·현재 code·현재 notes state를 읽지 않는다. Source SHA를 임의 alias하지 않는다.\n+원14/15 manifest·baseline·4정책·1780개 live 보호 파일과 원 source report는 live에서도\n+그대로여야 한다. 원 public bank raw도 보존하며 dynamic queue/counter/selector는 별도\n+현재 검증을 거친다. 원1781 목록을 바꾸거나 historical view로 current 검사를 대체할 수 없다.\n+\n+```sh\n+python scripts/notes_published15_closure.py --binding revisions/notes/published15-closures/ACTUAL-v1.json --verify-old\n+```\n+\n+## Held builder source와 최종 public gate의 분리\n+\n+공개된 source closure가 고정된 뒤 root가 G3 actual native 재평가와 별도 actual B의\n+inactive25 재감사를 마친다. 최신25 row는 반드시 COMPLETE/omissions[]이어야 하며\n+011의 원 inherited LEGAL_HOLD는 영구 보존한다. 다른 source-block/hold와 G3의 실제\n+결과를 KEEP/COMPLETE로 강제하지 않는다. R/E 및 C31 parent 실제 세션을 새 reviewer로\n+재사용하지 않는다. 실제 report/envelope/authorities/claim/integrate가 모두 필요하다.\n+\n+Read-only source 제안:\n+\n+```sh\n+python scripts/notes_held_sixteenth.py --propose-source --closure revisions/notes/published15-closures/ACTUAL-v1.json\n+```\n+\n+제안을 실제 `revisions/notes/held-n1-activation.json`으로 검토·커밋하고 source rawSHA,\n+actual closure와 actual reviewer receipt를 explicit 목록에 고정한다. 그러면 loader는\n+원 M16124…→정확한 N1e082… 한 unit만 바꿀 수 있다. 다른305 unit record와 원 guide,\n+원 census/report/negative는 그대로다. `independent_content_review: KEEP`을 옮기지 않고\n+provenance는 `HELD_COMPLETE_CENSUS_NOT_LEGAL_PASS`다. 이것은 빌더의 held source이며\n+게시 승인이 아니다. SOURCE 파일 하나를 만들거나 self-declared status를 넣어도 승인\n+목록·실제 pub/actual25 검사를 통과하지 못하면 실패한다.\n+\n+Root는 실제 N1을 선택한 미공개 branch에서 full-corpus ledger를 먼저 재생성·커밋하고\n+notes/study/refresh와 current progress를 순서대로 재생성한다. Source는 body를 따로\n+쓰는 writer를 제공하지 않으며 승인된 loader 입력만 합성한다. 실제 latest25 body/\n+census/claim binding이 맞을 때만 current 처리 coverage가 생긴다. 011 HOLD, public\n+unit warning, `requires_review`, daily 제외, canonical/question/legal release credit0은\n+그대로다. 79/96/99/100 같은 미래 수를 고정하지 않고 실제 source에서 다시 계산한다.\n+\n+최종 read-only manifest 제안:\n+\n+```sh\n+python scripts/notes_held_sixteenth.py --propose-migration --closure revisions/notes/published15-closures/ACTUAL-final.json\n+```\n+\n+현재 HEAD export/build가 실제 builder 결과와 같고 최신 notes evidence·sibling evolution·\n+현재 progress/default safety가 유효해야 제안이 나온다. Final closure는 source closure와\n+동일한 실제 published15 commit/tree/manifest여야 한다. 더 늦은 preimage 보완 revision도\n+정확히 explicit 승인된 것만 허용한다. 원 native job/event prefix는 append-only로 보존한다.\n+실제 source/output manifest를 `protected-migration-held-n1.json`에 새로 고정·커밋하고\n+별도 explicit approval을 해야16 decoder가 작동한다. Source 승인으로 public gate를\n+건너뛰지 않는다. Manifest가 없으면 기존 old15 guard가 N1을 거부하고, 있지만 승인되지\n+않았거나 stale이면16이 거부한다. 최종16은 frozen old15→14→…→original1781 검증을\n+실행한 뒤 원 Markdown bytes로 normalize하므로 live N1에 old guard를 적용하지 않는다.\n+\n+```sh\n+python scripts/notes_held_sixteenth.py --check\n+```\n+\n+현재 이 명령은 실제 pub closure, actual B25, 최종 current N1 manifest가 없어 BLOCKED다.\n+실제 published15 full-closure verification, actual B25 재감사, 실제 N1 build 및 full release\n+QA/CI/Pages는 NOT_RUN이다. Synthetic GitHub/HTTP/activation fixtures의 통과를 그 실제\n+단계의 PASS로 보고하지 않는다. 정책·원14/15·root state/generated/active body 변경은0이다.\n+\n+2026-11-04 handoff 시점에 root는 실제 PR192 main `e8f9b9bcffdb5cf8849ee97ba75b9526bd1cff67`,\n+tested `4c6380f14b516e6486c8ce8e8fdfcf75eb9ce7aa`의 동일 tree와 Pages41806902060 및\n+11개 workflow 성공을 보존했다. 실제 공개가 없다는 뜻으로 BLOCKED를 쓰지 않는다.\n+아직 이 코드의 normalized receipt/전체 preimage closure/explicit approval에는 결박하지\n+않았다는 뜻이다. 원 `pr192-publication-evidence/closure.json` 집계 기록은 보존하며,\n+그 값을 실제 원 PR/commit/run/asset payload의 정확한 binding으로 연결하는 새 wrapper가\n+필요하다. 원 집계 JSON을 이 receipt인 것처럼 이름만 바꾸거나 재구성하지 않는다.\n+\n+최종16은 현재 Q queue 원바이트와 모든 실제 통합 report, notes queue/ledger/evidence를\n+다시 결박한다. Q38–41 등 미완료 job 정의는0 credit이며 이후 상태·source가 바뀌면\n+기존16 manifest를 재사용할 수 없다. 미래 Q/notes 수나 결과를 승인 값으로 고정하지 않는다."},{"sha":"aedf03e758e7a1ebc8e5bbf218debb0653a38c2c","filename":"docs/NOTES_INACTIVE_CENSUS_SUCCESSOR.md","status":"added","additions":139,"deletions":0,"changes":139,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FNOTES_INACTIVE_CENSUS_SUCCESSOR.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FNOTES_INACTIVE_CENSUS_SUCCESSOR.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FNOTES_INACTIVE_CENSUS_SUCCESSOR.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,139 @@\n+# 비활성 N1 본문의 census 누락 재감사\n+\n+`INACTIVE_BODY_CENSUS_SUCCESSOR`는 이미 통합된 비활성 본문 감사의 census 누락만\n+보완하는 별도 controller purpose다. 기존 `CENSUS_ONLY_OMISSION_REASSESSMENT`의\n+실제 활성 본문 불변 검사는 바꾸지 않는다. `BODY_CORRECTION_REASSESSMENT`처럼\n+본문을 다시 수정하는 경로도 아니다. 이 구현은 source-only이며 실제 등록·claim·\n+본문 활성화·공개를 수행하지 않았다. Canonical/question/legal release credit는0이다.\n+\n+범위는 정확히 C31의 `w3-a-3` N1 후보 `e082d197…`와 원24 census에서 E25로 가는\n+한 번의 successor다. 원 C31 job/report/envelope/digest, 원 body registration record,\n+24 claim JSON 전체,42 source 객체,23KEEP/011LEGAL_HOLD, 분류문장 omission SHA와\n+E packet15파일 raw SHA를 고정한다. 원24 claim 객체는 metadata까지 그대로이고\n+`NOTE-CENSUS-V2-W3-A-3-ADD-001`만 추가한다. 추가 의미·다른 본문·새 atom·원명제나\n+source 변경·원 negative 누락은 실패한다. E의 source-only 검토는 독립 PASS가 아니다.\n+\n+E의 원 source commits `ee74466a…`와 `be8e5a82…`는 새 branch에 원바이트로 보존했다.\n+그 안의 `validate.py`는 당시 root ledger 등 과거 snapshot을 고정한 원 증거다.\n+현재의 합법적인 ledger annotation을 그 과거 바이트와 같다고 인증하지 않으며,\n+원 validator·handoff를 고쳐 현재 등록을 수행한 것처럼 바꾸지 않는다. 새 purpose는\n+원 packet bytes와 실제 C31, 실제 M 및 등록 시점의 별도 retained ledger를 검증한다.\n+\n+## 실제 M과 비활성 후보를 따로 결박\n+\n+Read-only preview는 다음과 같다. 미래 version record나 job을 만들지 않는다.\n+\n+```sh\n+python scripts/note_review_queue.py preview-inactive-census\n+```\n+\n+실제 활성 M semantic `e1519c02…`, 해당 절의 원 body `16124c09…`와 현재 binding을\n+유지한다. 새 E25를 공개 ledger에 선택하지 않는다. Preview는 현재 credit0,\n+HOLD·daily 제외와 실제 source/parent bindings를 반환한다. 다른305절의 등록 당시\n+claim binding은 실제 M ledger snapshot으로 결박한다. 이후 같은 본문의 sibling\n+census가 적법한 append-only native 재평가로 진화할 수 있다. 원 snapshot/binding은\n+그대로 두고, 원 binding에서 현재 binding까지 정확히 이어지는 등록 record·원명제 보존·\n+carry·HEAD source 및 실제 native history를 다시 검증한다. 미통합 등록은 처리 credit0이며\n+실제 INTEGRATED는 원 report/envelope/authority bytes와 event도 검증한다. 임의 row/source\n+변경·body 변경·최신 version의 과거 binding 복귀·누락된 native chain은 거부한다.\n+다른3절을 먼저 통합하고 새 실제 snapshot으로25를 등록하는 순서도 가능하다.\n+이미25를 등록했어도 후속 sibling version 때문에 역사 body record를 지우거나 고칠 필요가 없다.\n+\n+등록 record는 실제 활성 M snapshot과 비활성 N1 parent를 동시에 명시한다.\n+`notes_revision`은 기존 candidate-origin ID를 그대로 사용하며 미래 active N1의\n+revision·ledger hash를 추측하지 않는다. Record의 `inactive: true`와\n+`publication_blocker: ROOT_SEPARATE_16_FROM_ACTUALLY_PUBLISHED_15_SNAPSHOT`은 필수다.\n+\n+## Root의 실행 순서\n+\n+1. 진행 중인 모든 native note job을 실제 순차 통합한다. 현재 후속32/33 같은\n+   LEASED job이 있으면 새 등록은 실패하며 새 sequence를 미리 가정하지 않는다.\n+2. Root controller worktree에서 실제 `notes-unit-ledger.jsonl` 원바이트를 새\n+   `reports/full-corpus-review/body-corrections/w3-a-3-v1/inactive-census-successor/`\n+   아래 고유한 immutable snapshot 경로로 복사하고 커밋한다. 다른305 binding과\n+   현재 target M binding이 실제 inventory와 일치해야 한다.\n+3. Read-only 제안 helper로 실제 record를 만든다. 명령 출력만으로 등록되지 않는다.\n+\n+   ```sh\n+   python scripts/note_review_queue.py propose-inactive-census \\\n+     --id ACTUAL_UNIQUE_INACTIVE_RECORD_ID \\\n+     --ledger-snapshot reports/full-corpus-review/body-corrections/w3-a-3-v1/inactive-census-successor/ACTUAL-M-LEDGER.jsonl\n+   ```\n+\n+   결과는 전용 prefix의 새 JSON record로 보존·검토·커밋한다. Helper는 실제\n+   HEAD-retained snapshot만 읽으며 미래 active N1 version을 생성하지 않는다.\n+4. 기존 root-only checkpoint로 append 등록한다.\n+\n+   ```sh\n+   python scripts/note_review_queue.py --actor /root reassess-inactive-census \\\n+     --record reports/full-corpus-review/body-corrections/w3-a-3-v1/inactive-census-successor/ACTUAL-RECORD.json\n+   ```\n+\n+   Queue에 새 purpose와 정확한 binding/author/negative/review 계약을 append한다.\n+   같은 path·bytes는 멱등적이고 다른 bytes·복제 등록·동시 미완료 wave는 거부한다.\n+   실패한 명령은 기존 atomic checkpoint를 쓰지 않는다.\n+5. 원 runbook의 claim/worktree/heartbeat/recover/submit/integrate를 그대로 사용한다.\n+   R/E와 원 body/source 작성자, C31의 실제 parent reviewer 세션은 새 fresh reviewer로\n+   재사용할 수 없다. Root가 실제 새 non-author 세션을 지정하고 기존\n+   controller-attested provenance를 유지한다. Identity 문자열 자체를 인증으로 과장하지 않는다.\n+6. Worker는 정확한 비활성 body 전문과25개 claim, 원24 객체와42 sources 보존,\n+   C31 원 omission·011 blocker·원19/24 negative 이력, 관련 derived 입력 및 직접 관련\n+   question 연결을 실제로 다시 읽는다. 새 authority는 exact section/HTTPS URL,\n+   시행일 또는 미확정 한계, 실제 retrieval/read/review date와 raw SHA를 남긴다.\n+   `related_question_ids: []`는 미평가이며 관련 없음의 증거가 아니다.\n+7. Worker는 기존 허용 evidence 경로만 commit한다. 실제 HEAD 후 envelope를 만들고\n+   root가 submit→증거 cherry-pick→원 envelope bytes commit→순차 integrate한다.\n+   Old worker Git 검사는 controller에 유지하고 HEAD-only 공개 reader만 old Git-free다.\n+\n+## 새 report 계약과 credit\n+\n+각 row는 기존 note report 전부와 `actual_body_sha256`, 실제 `reviewed_at`, 아래\n+object 및 각 원 omission의 `original_omission_reassessments`를 가진다.\n+\n+```python\n+row['inactive_census_successor_review'] = {\n+    **job['inactive_census_successor_review'],\n+    'final_candidate_body_read_completely': True,\n+    'final_census_read_completely': True,\n+    'all_original_omissions_reassessed': True,\n+    'all_original_propositions_preserved': True,\n+    'all_derived_inputs_read_completely': True,\n+    'no_current_credit_before_matching_active_binding': True,\n+}\n+```\n+\n+실제로 하지 않은 읽음을 true로 만들지 않는다. 원 omission의 exact SHA별로 실제\n+finding과 `RESOLVED_BY_FRESH_COMPLETE_BODY_CENSUS_REVIEW` 또는\n+`UNRESOLVED_REMAINS_OMISSION`을 기록한다. 미해소 원 omission은 현재 omissions에도\n+남기며 새 누락은 별도로 더한다. KEEP claim의 실제 official source provenance는\n+BODY review와 같은 LIVE/SAME_DAY_RETAINED_CACHE, HTTP200 문서 정체, 원 payload SHA와\n+날짜 순서를 검증한다. Access page/403은 증거가 아니다.\n+\n+011 등 `job.carried_legal_blockers`는 원 finding/blocker/report SHA 및 상속 이력까지\n+정확히 보존한다. 동일 문장의 HOLD를 새 positive 의견으로 해제할 수 없다.\n+24개의 과거 KEEP/HOLD도 새25 census에 대한 전수 fresh 검토를 대신하지 않는다.\n+COMPLETE와 LEGAL_HOLD는 공존하며 새 누락이 있으면 OMISSIONS_FOUND다.\n+\n+등록·LEASED·SUBMITTED와 실제 M이 활성인 INTEGRATED 결과 모두 현재 completeness/\n+author/legal/release credit0이다. Metadata는 후보 검토와 원 history를 보존하고\n+`current_review_valid: false`, HOLD, daily 제외를 유지한다. 새 author census는\n+M의 선택 census/count에 추가하지 않는다. 실제로 외부16 guard가 N1을 활성화하고\n+latest25 body+census+claim binding과 통합 결과가 모두 일치할 때만 최신 하나의\n+처리 coverage를 계산할 수 있다. 그때도011HOLD와 `coverage_is_legal_pass: false`,\n+canonical/question credit0은 그대로다. Stale N1/24나 부분 binding은 허용하지 않는다.\n+\n+## 공개 blocker와 검증\n+\n+이 구현에는 N1 활성화 writer나16 manifest가 없다. 아직 미공개15에 섞지 않는다.\n+실제15 공개 snapshot의 고정 검증 closure를 확보한 뒤 별도16 held-note activation,\n+원14/15 guards,1781 보호, derived·daily·현재 source/metadata/fullQA를 검증해야 한다.\n+기존 positive-only activation을 HOLD 통과용으로 완화하지 않는다.\n+\n+```sh\n+python -m pytest -q tests/test_notes_inactive_census_successor.py \\\n+  tests/test_notes_body_reassessment.py tests/test_notes_census_reassessment.py \\\n+  tests/test_note_review_queue.py tests/test_notes_independent_metadata.py\n+```\n+\n+테스트의 parent/body/census/authority·HTTP와 미래16 activation은 명시적 synthetic\n+fixture다. 실제 registry 등록·독립 법규 검토·현재 coverage·출시 증거로 세지 않는다."},{"sha":"5da446da23d52de9d1581442636e6b689eda62cb","filename":"docs/PHASE11_CONTEXT38_REVIEW.md","status":"added","additions":64,"deletions":0,"changes":64,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FPHASE11_CONTEXT38_REVIEW.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FPHASE11_CONTEXT38_REVIEW.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FPHASE11_CONTEXT38_REVIEW.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,64 @@\n+# D38의 집계 노출과 별도 fresh 검토\n+\n+이 경로는 이전 체크포인트의 D40 집계가 새 full-history 세션에 전달되어,\n+명시된 두 예외를 제외한 38문항의 이전 positive 결론을 추론할 수 있었던 문제를\n+처리한다. 원 보고서의 실제 검토·판정·부정적 finding은 지우지 않는다. 작성자 검토,\n+노출된 재검토, 실제 fresh 독립 검토와 출시 승인을 서로 구분한다.\n+\n+`scripts/phase11_context38_metadata.py`는 정확히 EXP0321–0360 중 0338/0339를\n+제외한 38개만 읽는다. 기존 CASE0401/0441 consumer 및 EXP0338/0339 consumer의\n+고정 범위와 계약은 변경하지 않는다. 새 고정 경로는 다음과 같다.\n+\n+- State: `reports/full-corpus-review/phase11-context38-recheck-work-queue.json`\n+- Header: `phase11_context38_scope`\n+- Purpose: `FIXED_PHASE11_CONTEXT38_FRESH_SECONDARY_REVIEW_NO_RELEASE_OVERRIDE`\n+- Native job: `review-independent-legacy-phase11-context38-f2f730cb3b7befe7`\n+- 실제 새 actor/session: `/root/fresh_d_remaining38`\n+- Disclosure: `reports/full-corpus-review/resume-20261104/d38-aggregate-exposure-disclosure.json`\n+\n+소비자는 커밋된 원 checkpoint의 고정 raw SHA, D의 38 KEEP/38 YES·두 예외,\n+실제 root의 `fork_turns_all` 노출 선언, aware 관찰 시각, 원 report SHA와\n+각 primary row SHA, 현재 question 객체·collection·assignment hash를 결박한다.\n+다른 primary finding, 다른 보고서, 임의 38개, 다른 reviewer나 추가 job은 거절한다.\n+Disclosure의 primary fresh credit과 canonical release credit은 정확히 정수0이다.\n+\n+새 state가 있으면 `QUEUED`/`LEASED`/`SUBMITTED` 단계에서도 기존 38개의 key는\n+독립 fresh 정답 판정 집계에서 즉시 제외한다. 원문 실독 수는 그대로다.\n+`excluded_primary_key_ids`를 사용하는 합집합 helper는 **집계용 복사본**의 key만\n+NOT_ASSESSED로 처리하고, 원 primary row와 보고서 바이트는 수정하지 않는다.\n+실제 통합된 별도 fresh 결과 중 NOT_ASSESSED가 아닌 고유 ID만 다시 더한다.\n+HOLD·AMBIGUOUS도 판정 범위일 수 있으며 법규 PASS가 아니다.\n+\n+`INTEGRATED` 결과는 원 native controller의 Git/lease/submit/integrate 검사를\n+통과해야 한다. 소비자는 현재 HEAD의 source·envelope·report 원바이트, 정확38 ID,\n+실제 actor/session·instance, native assignment 7필드, claim/submit/integrate event와\n+공식 authority의 raw·text SHA, 조항·검토일·효력일 또는 UNKNOWN 한계를 확인한다.\n+새 reviewer가 이전 결론에 노출되었다면 그 key는 다시 NOT_ASSESSED로 남는다.\n+그 row의 PASS도 fresh 현실성 집계에 넣지 않는다. 노출 disclosure를 보존한 채\n+queue만 삭제해 과거 38개의 credit를 복원하려는 상태 역시 거절한다.\n+\n+각 원장 row의 `independent_legacy_primary_assessment_limitation`은 원 보고서·row\n+SHA와 disclosure binding을 남긴다. 실제 fresh 결과가 통합되면 해당 보충 보고서와\n+envelope 증거 참조를 추가한다. 원 primary의 KEEP/YES와 부정적 법규·현실성 판단,\n+저자 finding 및 사용자 기록은 그대로 보존한다. 이 경로의 fresh positive만으로\n+이 38문항을 기본 연습에 복귀시키거나 RELEASED로 승격할 수 없다.\n+\n+현실성도 context38의 기존 PASS를 fresh PASS 수에서 제외한다. 실제 fresh PASS와\n+고유 ID 합집합을 계산하되, 원 primary FAIL과 충돌하는 새 PASS는 effective PASS로\n+승격하지 않는다. 새 PASS 원수·그중 보존된 FAIL과 충돌하는 수·제외한 기존 PASS 수를\n+별도로 기록하므로 실제 검토 결과를 숨기거나 이전 negative를 지우지 않는다.\n+\n+Builder의 전체 정답 판정 수는 primary 및 세 별도 consumer의 고유 합집합이다.\n+기존 두 consumer의 개별 historical progress는 그대로 유지하며, 현재 전체 값은\n+`independent_legacy_supplementary_review`와\n+`independent_legacy_context38_supplementary_review`에서 제외 내역을 명시한다.\n+신원 문자열과 root의 노출 선언은 실제 세션 출처를 결박하는 진술이며 독립성을\n+수학적으로 인증한다고 표시하지 않는다.\n+\n+```sh\n+python -m pytest -q tests/test_phase11_context38_metadata.py \\\n+  tests/test_phase11_secondary_metadata.py tests/test_procedural_secondary_metadata.py\n+```\n+\n+Synthetic fixture 통과와 실제 pending-source reader 검증은 fresh 법규 판정이나\n+전체 후보 QA·배포 완료 증거를 대신하지 않는다."},{"sha":"002e12ab2e3e0aeea50751a4114ed667fa868918","filename":"docs/PHASE11_PROCEDURAL_SECONDARY_REVIEW.md","status":"added","additions":66,"deletions":0,"changes":66,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FPHASE11_PROCEDURAL_SECONDARY_REVIEW.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FPHASE11_PROCEDURAL_SECONDARY_REVIEW.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FPHASE11_PROCEDURAL_SECONDARY_REVIEW.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,66 @@\n+# Phase11의 노출된 두 정답에 대한 별도 보충 검토\n+\n+`scripts/phase11_secondary_metadata.py`는 정확히 `MA-EXP-0338`과\n+`MA-EXP-0339`만 읽는 추가 소비자다. 기존 `procedural_secondary_metadata.py`의\n+CASE0401/0441 계약·허용 범위는 변경하지 않는다. 공통 reader·source SHA·provenance\n+검사 helper만 재사용한다. 이 코드는 실제 보고서·배정·원장·공개 결과를 만들지 않는다.\n+\n+고정 state는 `reports/full-corpus-review/phase11-procedural-recheck-work-queue.json`,\n+scope header는 `phase11_fresh_two_scope`이며 purpose는\n+`FIXED_PHASE11_TWO_PRIOR_EXPOSURE_SECONDARY_REVIEW_NO_RELEASE_OVERRIDE`다.\n+표준 independent-legacy 큐의 native claim/submit/integrate를 사용하되 단 하나의\n+job과 이 두 ID를 벗어난 state는 미통합 추가 job까지 전부 거절한다.\n+\n+부모는 `reports/full-corpus-review/recovered-phase11-d-review.json`의 실제\n+`/root/recover_d_review` 세션이다. 두 row는 `HOLD`/`NOT_ASSESSED`, blocker\n+`PRIOR_CONCLUSION_EXPOSURE_REQUIRES_GENUINELY_FRESH_SESSION`와\n+`release_eligible: false`를 유지해야 한다. `independently_expected_key`는 미판정\n+빈 배열이고 `exposure_limitations.prior_item_conclusion_seen: true`,\n+`fresh_whole_key_credit: 0`도 그대로여야 한다. 다른 실질 법규 보류나 임의 미평가를\n+이 절차적 재검토로 재분류하지 못한다. Root는 각 `previous_evidence`에 다음을\n+실제 커밋 바이트로 결박한다.\n+\n+- `report_path`, `report_sha256`: 위 부모 보고서와 raw SHA.\n+- `record_sha256`: 원 row 전체의 canonical SHA.\n+- `question_record_sha256`: 실제 현재 question 객체의 canonical SHA.\n+- `original_actor`: `/root/recover_d_review`.\n+- `reason`: `ROOT_ATTESTED_PRIOR_PROCEDURAL_EXPOSURE_NOT_A_SUBSTANTIVE_LEGAL_VERDICT`.\n+\n+새 실제 세션은 `/root/fresh_two_keys`이며 actor와 session 모두 이 값이어야 한다.\n+`fresh_reviewer`와 `result_envelope`의 구조는 기존 bounded consumer runbook\n+[PROCEDURAL_SECONDARY_REVIEW.md](PROCEDURAL_SECONDARY_REVIEW.md)와 같다.\n+이름만으로 독립성을 입증한다고 하지 않는다. Root의 실제 fresh 세션·작성자 이력\n+확인이 필요하며 원 reviewer instance, known authors, 원문에 기록된 작성자 신원을\n+새 auditor로 사용할 수 없다.\n+\n+`QUEUED`/`LEASED`/`SUBMITTED`는 보충 credit0이다. `INTEGRATED`일 때만 현재 HEAD에\n+커밋된 원 report/row/현재 question/envelope/fresh report/official raw·text SHA와\n+native claim·submit·integrate event를 확인한다. 실제 worker commit 검증은 원\n+controller에 유지하며 소비자는 shallow CI에서도 HEAD 바이트로 검증한다.\n+재노출된 fresh row는 `NOT_ASSESSED`를 유지하고 key credit를 얻지 못한다.\n+\n+Builder는 원 primary legal/realism/history/HOLD를 그대로 두고\n+`independent_legacy_supplementary_assessment`에 별도 결과를 기록한다. 기본 연습\n+containment는 primary와 두 consumer의 결과 모두에 적용한다. 추가 KEEP는 원\n+negative를 덮거나 원문을 RELEASED로 승격하지 못한다.\n+\n+원장 집계는 primary 및 두 별도 보충 consumer에서 정답을 평가한 **고유 ID 합집합**이다.\n+원문 실독 수는 primary의 고유 수를 유지하고 두 번 더하지 않는다. 기존\n+`independent_legacy_procedural_supplementary_review`는 원 bounded2의 값 그대로이며\n+새 `independent_legacy_phase11_supplementary_review`는 새 두 결과만 기록한다.\n+둘의 합집합은 `independent_legacy_supplementary_review`에 별도로 나타난다.\n+HOLD/AMBIGUOUS를 포함한 정답 판정 범위이며 법규 PASS나 canonical release 비율이 아니다.\n+\n+```sh\n+python -m pytest -q tests/test_phase11_secondary_metadata.py \\\n+  tests/test_procedural_secondary_metadata.py tests/test_legacy_independent_metadata.py \\\n+  tests/test_review_queue.py tests/test_full_corpus_review.py\n+```\n+\n+Fixture 통과는 실제 보고서·독립 법규 감사·배포 증거를 대체하지 않는다.\n+\n+실제 fresh 보고서의 `native_assignment_binding`에는 job ID·sequence·question hashes·\n+stage·worker·worker branch·attempt가 해당 native job과 모두 같아야 한다. 별도\n+최상위 `job_id`가 있으면 그것도 같아야 하며, 이미 커밋한 보고서에 이 필드를\n+추가하려고 원바이트를 덮어쓰지 않는다. 기존 다른 bounded consumer는 이 형식으로\n+확장하거나 변경하지 않는다."},{"sha":"1a027d3bc0fad01b0b69a4cd67a7426944fd3c8c","filename":"docs/REVIEW_QUEUE.md","status":"modified","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FREVIEW_QUEUE.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/docs%2FREVIEW_QUEUE.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/docs%2FREVIEW_QUEUE.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -58,6 +58,33 @@ python scripts/review_queue.py recover\n \n ## 증거 제출과 순차 통합\n \n+### 작업자 환경이 사라진 경우의 명시적 임대 회수\n+\n+아직 만료되지 않은 임대를 만료된 것으로 기록하지 않는다. 작업자 디스크가\n+실제로 사라졌거나 작업자가 더 이상 제출할 수 없음을 확인한 root controller만\n+현재 token과 구체적인 사유로 임대를 회수할 수 있다.\n+\n+```bash\n+python scripts/review_queue.py --stage independent-legacy --actor /root revoke \\\n+  --job JOB --token CURRENT_TOKEN --reason '기존 작업자 디스크를 복구할 수 없어 새 실제 세션에 재배정'\n+python scripts/review_queue.py --stage independent-legacy claim --worker ACTUAL_NEW_ACTOR\n+```\n+\n+`LEASE_REVOKED` event는 실제 회수 시각, 이전 작업자·branch·임대기한·attempt와\n+token SHA를 보존한다. 기존 event와 증거를 지우지 않으며 `LEASED`만 `QUEUED`로\n+되돌린다. 이전 token은 즉시 무효이며 새 claim은 attempt와 branch를 새로 만든다.\n+원 작업자의 provenance를 새 reviewer의 provenance로 가장하지 않는다. 제출·통합된\n+결과는 회수할 수 없다. 같은 token/사유로 아직 QUEUED인 동일 attempt에 재요청하면\n+멱등적이며, 다른 사유나 새 attempt에 대한 옛 token 요청은 거절한다.\n+\n+노트 큐에도 같은 명령을 사용한다. 실제 controller checkpoint 위치에서 실행하며\n+기존 본문·census binding, 부모 검토의 HOLD와 author 제외 규칙은 변경하지 않는다.\n+\n+```bash\n+python scripts/note_review_queue.py --actor /root revoke \\\n+  --job JOB --token CURRENT_TOKEN --reason '기존 작업자 디스크를 복구할 수 없어 새 실제 세션에 재배정'\n+```\n+\n 작업자는 기존 문항별 검토 보고서를 작성하고 commit합니다. controller에 전달할 별도 manifest는 다음 형식입니다. 같은 보고서가 여러 ID를 포함하면 path와 파일 SHA를 각 ID에 반복 참조할 수 있습니다. manifest 자체는 worker commit 뒤에 작성해도 됩니다.\n \n ```json"},{"sha":"bd66395595d8a33e488c7b1279ad99f7f2ffad24","filename":"practice_expansion/2026-10-28-representative/questions.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/practice_expansion%2F2026-10-28-representative%2Fquestions.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/practice_expansion%2F2026-10-28-representative%2Fquestions.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/practice_expansion%2F2026-10-28-representative%2Fquestions.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -29,7 +29,7 @@\n     \"reports/representative-rewrite/default-holds.json\": \"dddf54526796c2a48128cac835a8418893ab913fc2de6a4a3f5ddfe7c1c34fb8\",\n     \"reports/full-corpus-review/phase5-default-editorial-holds.json\": \"83b7925292e14a04fa9b1881fc883544360745241c16105f22c52d88dfd3266f\",\n     \"reports/full-corpus-review/phase7-default-editorial-holds.json\": \"631ffd48daaa77f7ffca8fd9b5b9a3d53b2aeaf96cba6f5df2de60f89e6a1afa\",\n-    \"reports/representative-rewrite/archive-review-notices.json\": \"81b5d83f20f425c0893d84d304c31ee8944dee7ec3e3db4dfddd23ec9fce949c\",\n+    \"reports/representative-rewrite/archive-review-notices.json\": \"eb0e241d533c8dfd3da41b9205f54db480e77c87884d09b9d77bc851c46eee97\",\n     \"reports/representative-rewrite/nonlegacy-default-holds.json\": \"e8bc7ca467e78c41dd355223b6f05d0e17fb32bee993b374e4deae3d3b36f5c3\",\n     \"reports/full-corpus-review/wave14-1-author-review.json\": \"3d3d555519ed8233f856fd0927f9818d1e8d5f48c363718101fbace135367d87\",\n     \"reports/full-corpus-review/wave14-2-author-review.json\": \"7af503888c560388be40989d65cb305261665199f677fa879fd5cfea3c3eee17\","},{"sha":"dbfa6224675478980db7a7dd6fad2244c7f89186","filename":"practice_expansion/2026-10-28-representative/selection.json","status":"modified","additions":6830,"deletions":414,"changes":7244,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/practice_expansion%2F2026-10-28-representative%2Fselection.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/practice_expansion%2F2026-10-28-representative%2Fselection.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/practice_expansion%2F2026-10-28-representative%2Fselection.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67"},{"sha":"6ea7964669168b803327eeb3462fe8b9461d6e4b","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/README.md","status":"added","additions":17,"deletions":0,"changes":17,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2FREADME.md","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2FREADME.md","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2FREADME.md?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,17 @@\n+# w3-a-3 N1 census v2 저자 보완본\n+\n+현재 상태는 `BLOCKED_PENDING_N1_ACTIVATION_AND_NATIVE_REGISTRATION`이다. 본문을 바꾸지 않고 C31의 실제 누락 하나를 추가한 source-only 저자 보완이며, 독립 재감사나 활성화 완료가 아니다.\n+\n+- `census.json`: 원24개 claim object와 원42개 source object를 모든 필드 그대로 보존하고 `NOTE-CENSUS-V2-W3-A-3-ADD-001` 하나를 추가한25개 명제. 원문 e082…의 제조사 제품 용기 변경/법적 분류 한정 문장을 그대로 열거한다.\n+- `author-review-memo.json`: 저자 E의 독립적인 materiality 확인과 새 명제1개에 대한 직접 공식 자료 검토 범위. 기존24의 법규 판정을 새로 했다는 주장이 아니다.\n+- `author-handoff.json`: C31 job/report/result 전체 binding, 모든 원claim→동일claim mapping, 정확 omission 문자열 SHA, 추가1개, C011의 원 inherited blocker 전체, 활성화/등록 전제.\n+- `preservation-manifest.json`: 원claim24 canonical record SHA 및 기존56개 보호 artifact raw SHA. 원 census와 C 보고서·result·candidate·정책·queue/ledger가 그대로인지 재검증한다.\n+- `evidence/`: 2026-11-04 정상 TLS LIVE로 새 확보한 §11239D와 Board Policy2023-01 원바이트/추출문/회수·실독 시각. 개별 조항 시행 이력 미확인은 UNKNOWN으로 남기며 Board policy를 법률과 같은 권위로 쓰지 않는다.\n+\n+원 author JSON의011·019·024 SOURCE_BLOCKED 이력은 변경하지 않았다. C31의011 LEGAL_HOLD와 원 inherited blocker 역시 그대로 유지한다. C31의019/024 changed-proposition KEEP는 별도 이력이며 이번 저자 보완으로 원본 negative를 덮지 않는다. 새 명제의 question alignment는 `NOT_ASSESSED`, related IDs는 빈 배열이다.\n+\n+N1 body SHA는 `e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a`이나, 관측한 실제 활성 body는 `16124c0925f7388178a9218895ea8d511436f2ca601c56f6c503e5c180e2bffc`이며 active ledger는 기존23개 census를 선택한다. 그러므로 native version record를 만들지 않았다. Root가 별도16 publication/migration으로 N1을 실제 활성화하거나 별도 검증한 inactive-body workflow를 마련한 뒤, 실제 현재 ledger/notes revision/parent binding으로만 등록해야 한다. 미래 ledger SHA를 추정해 넣으면 안 된다.\n+\n+이 보완본의 실제 작성자는 같은 E 세션/instance이다. 원 body 저자 R과 census 보완 저자 E는 후속 독립 검토에서 제외해야 한다. 실제 non-author B/C가 최종 본문과25개 명제 전부를 다시 확인해야 한다. 독립/canonical/question/current coverage credit는 모두0이다.\n+\n+재검증: `python reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/validate.py` (정상 packet 및 변조 거부17검사)."},{"sha":"a961c57f1d1fd44a976deff8d6ce0387eb8efc5a","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/author-handoff.json","status":"added","additions":365,"deletions":0,"changes":365,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fauthor-handoff.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fauthor-handoff.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fauthor-handoff.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,365 @@\n+{\n+  \"schema_version\": 1,\n+  \"purpose\": \"SOURCE_ONLY_AUTHOR_CENSUS_OMISSION_CORRECTION_HANDOFF\",\n+  \"status\": \"BLOCKED_PENDING_N1_ACTIVATION_AND_NATIVE_REGISTRATION\",\n+  \"created_at_utc\": \"2026-11-04T05:49:25.114154+00:00\",\n+  \"actor_provenance\": {\n+    \"actor_id\": \"/root/independent_case_e\",\n+    \"session_id\": \"/root/independent_case_e\"\n+  },\n+  \"author_instance\": \"gpt-independent-session-root-independent_case_e-20261103\",\n+  \"same_actual_session\": true,\n+  \"independent_of_authors\": false,\n+  \"known_author_ids\": [\n+    \"/root/independent_procedural_retry\",\n+    \"AUTHOR_NOTE_WAVE8_CODEX_20261103_NOT_INDEPENDENT\",\n+    \"/root/independent_case_e\"\n+  ],\n+  \"future_independent_review_excluded_actor_ids\": [\n+    \"/root/independent_procedural_retry\",\n+    \"/root/independent_case_e\"\n+  ],\n+  \"historical_author_descriptor_not_fabricated_actor_id\": \"AUTHOR_NOTE_WAVE8_CODEX_20261103_NOT_INDEPENDENT\",\n+  \"unit_id\": \"w3-a-3\",\n+  \"inactive_candidate_revision\": {\n+    \"path\": \"revisions/notes/candidates/2026-11-04-w3-a-3-pamphlet-scope-v1.json\",\n+    \"raw_sha256\": \"b2f8c8db6d4c2538edf410939eaf9ce4396973d203fcd70ccb5ed1fc4164ed76\",\n+    \"revision_id\": \"2026-11-04.w3-a-3-pamphlet-scope.inactive.1\",\n+    \"body_sha256\": \"e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a\",\n+    \"inactive\": true\n+  },\n+  \"parent_independent_review\": {\n+    \"job_id\": \"review-independent-notes-body-4c3229fb7bfb76b6\",\n+    \"job_status\": \"INTEGRATED\",\n+    \"previous_job_sha256\": \"0d47c2ef9a60800988de3f59adc6b3205c67985bc2c21200f457a710311833d3\",\n+    \"previous_binding\": {\n+      \"body_sha256\": \"e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a\",\n+      \"census_path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/census.json\",\n+      \"census_sha256\": \"3989096b1c43abfd73996e8ce99abe52699cdadd4ada8252ce7514540cf65a04\",\n+      \"census_unit_record_sha256\": \"52d990ee757bde0a24927369862047b845ee9874bfb9b98eb872cf2955638e37\",\n+      \"ledger_binding_sha256\": \"4c3ccbe2fc2db28bf56d58ff1afc839f6abd258f0adfa76891549d0a0ff2177c\",\n+      \"claim_record_sha256s\": {\n+        \"NOTE-WAVE8-W3-A-3-001\": \"f5d6567fe7e4114170e0ac1707a25ce646911c17d417ce88821f
-v1%2Finactive-census-successor%2FM-notes36-ledger-at-registration.jsonl","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Finactive-census-successor%2FM-notes36-ledger-at-registration.jsonl?ref=c8e8f7b825e576887220867b322779dc5b1c8d67"},{"sha":"c4d8fdceaaf018a464ac666a936ff9778481094c","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/inactive-census-successor/inactive-w3-a-3-census25-c31-20261104.json","status":"added","additions":256,"deletions":0,"changes":256,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Finactive-census-successor%2Finactive-w3-a-3-census25-c31-20261104.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Finactive-census-successor%2Finactive-w3-a-3-census25-c31-20261104.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Finactive-census-successor%2Finactive-w3-a-3-census25-c31-20261104.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,256 @@\n+{\n+  \"schema_version\": 1,\n+  \"purpose\": \"INACTIVE_BODY_CENSUS_SUCCESSOR\",\n+  \"inactive_census_successor_id\": \"inactive-w3-a-3-census25-c31-20261104\",\n+  \"unit_id\": \"w3-a-3\",\n+  \"inactive\": true,\n+  \"publication_blocker\": \"ROOT_SEPARATE_16_FROM_ACTUALLY_PUBLISHED_15_SNAPSHOT\",\n+  \"change_basis\": \"C31 exact omitted classification atom; same inactive body; no legal blocker closure\",\n+  \"body_sha256\": \"e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a\",\n+  \"previous_job_id\": \"review-independent-notes-body-4c3229fb7bfb76b6\",\n+  \"previous_job_sha256\": \"0d47c2ef9a60800988de3f59adc6b3205c67985bc2c21200f457a710311833d3\",\n+  \"
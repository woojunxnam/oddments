+    {\n+      \"path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/evidence/retrieval.json\",\n+      \"raw_sha256\": \"6aa3006189a32d39a01ae1fd893095703e411cfcee01f82202855614d053bedd\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/inactive-preview.json\",\n+      \"raw_sha256\": \"3ff477226ccd58b4542b37e50493fd853bbca2ee3b7de1c1e35bc56dd0394086\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/record.json\",\n+      \"raw_sha256\": \"cfe060fb2bb2a06769d02f712899ca7de8b24e5f3538b82a0744a125d8c5722d\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/registrations/after-census-v2.json\",\n+      \"raw_sha256\": \"945e120c2676793b7f6649d0eaa5a3cb4eb22b3f2e85fd56d273331a0730dd1c\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/registrations/pre-census-v2-ledger.jsonl\",\n+      \"raw_sha256\": \"645d7636c77163b5c6d284cd62f0498b3da66048fc87c4bf52f8e73214c2726e\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes-work-queue.json\",\n+      \"raw_sha256\": \"cc3899e468097d8548718ff3e1c1fb6b2030963572701fc32c4c13fc4de1e329\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/act2025c16.html\",\n+      \"raw_sha256\": \"0d57fc53cf17a99fbe95cb034456aaa66bffba62c0aaa6125297555f2b43c569\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/act2025c16.txt\",\n+      \"raw_sha256\": \"64157508009f252131d28140a621120326ce3dbc56a44b70b663c99637b8e16b\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/candidate-body-first.json\",\n+      \"raw_sha256\": \"37924b7126d3c84143ab75066a0da22353acdce63d2d697d96c1e872055fadfa\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/cfr1306.08.html\",\n+      \"raw_sha256\": \"17c82f5e720511a9f9e6ed22df011bd8d25e71113334ece2d5b831ee819e3b3c\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/cfr1306.08.txt\",\n+      \"raw_sha256\": \"f4cb68efea24b31c6b581921b7c7c29e9947aedb0405d23b3081ace2cc214244\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/cfr1306.25.html\",\n+      \"raw_sha256\": \"0d83bb462cb67d1583da117fe4dfd240a787e9712bd8804e4fa212e1b07ce08e\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/cfr1306.25.txt\",\n+      \"raw_sha256\": \"24434593760a01133a4c1a096f8ffade331a324b7f4c39c3bb3d04bb53192bab\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/cfr290.5.html\",\n+      \"raw_sha256\": \"29d222f59c24c4714106feb6e02f37520cea7b6e384e7ea0c7afc144a3095e38\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/cfr290.5.txt\",\n+      \"raw_sha256\": \"28336386e4687dbaf55f2c9096c04c88e5210115975d3e4d4b896ba5d0022ef0\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/derived-inputs-safe.json\",\n+      \"raw_sha256\": \"f708c6d8ec665beab7a12687fda40a348c2ce4083f03fb99af9300340e8ca620\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/evidence-scope.md\",\n+      \"raw_sha256\": \"d0986a59933f78385bc25e02f745d5424545cfdd77fc7bf6e254e2bc743cbd02\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/mgl11239d.html\",\n+      \"raw_sha256\": \"cfc05f5c2037c4308be48bdd000b81684bde70f664c52d1cc169163fc5762a58\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/mgl11239d.txt\",\n+      \"raw_sha256\": \"25d99980a9c3f1b740a4e068e8c67ca0a66163f0c416dd13d3a2b00f13412451\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/mgl19a14.html\",\n+      \"raw_sha256\": \"ffef27e84d45a50eacca6cbcd50d770f4252b2330087c045cffe62e0757ddfab\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/mgl19a14.txt\",\n+      \"raw_sha256\": \"df7207c9f751f33bf083b801bcdc5f25e7b3ee380dcd9d9180468dfe9c6456f1\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/mgl94c21.html\",\n+      \"raw_sha256\": \"055e07f501d4e7e6d38ee7669de04ea145c90f0ae5f8c750499778d56fcb0e6e\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/mgl94c21.txt\",\n+      \"raw_sha256\": \"2c209f92c85c72502dce4793619dbdaed34054e7cba7490f6569decf1a9d6a94\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/packaging.pdf\",\n+      \"raw_sha256\": \"b3a205bbd29c3eca5e733d08fcef9d79650b00ea0a9dbc156b4eb474200bd548\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/packaging.txt\",\n+      \"raw_sha256\": \"cdc922e9a87b6c93ca18cef2961bac9e2029a036ef1c8b17a72d0110f7a41420\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/precommit-validation.json\",\n+      \"raw_sha256\": \"8d3607d244899e1ebbec379552167cbc9366d887700ca69917b8fe037eb5f9bb\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/preservation-proof.json\",\n+      \"raw_sha256\": \"1c017c473ae9fa0544134371ad59a7029bc32aec614e32d29640920dad897cc4\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/question-alignment.json\",\n+      \"raw_sha256\": \"14b7fc9aae91442a92313810d040168b772c73d2d4f1626d4b43320365298fdb\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/questions-lossless.json\",\n+      \"raw_sha256\": \"b7e114a1d480d9a034f4fe4c1022b07a3801c817bb81f6b62f192582689cc592\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/questions-safe.json\",\n+      \"raw_sha256\": \"61735af3b13a034913fd0b50b0e25c52e4d10945ed9e0e1880f69d33e2465489\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/retrieval-log.json\",\n+      \"raw_sha256\": \"29e9f8da6ba3e7a5a2527eba3fdb956fc75969a93794fccd30f9550c3b4e88e5\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-evidence/validate-body-v1-c.py\",\n+      \"raw_sha256\": \"49798bd25f959924a62dded6da355c2370310b0f0cf4e0ad9d79198f000d6e63\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/body-v1-c-review.json\",\n+      \"raw_sha256\": \"16d98bf341fc6263b26e0b6d4efc9d6b2cfc148b5639aba510248e8a77d863a3\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/independent-notes/review-independent-notes-body-4c3229fb7bfb76b6-result.json\",\n+      \"raw_sha256\": \"09c1e733bcfd5e463436d07792befdb019fe92619d288a998037b04c60e59bc2\"\n+    },\n+    {\n+      \"path\": \"reports/full-corpus-review/notes-unit-ledger.jsonl\",\n+      \"raw_sha256\": \"fa55519ec2f494925cbf16101401b1e6830c170ae4e90ba188e34d61725dd504\"\n+    },\n+    {\n+      \"path\": \"revisions/notes/candidates/2026-11-04-w3-a-3-pamphlet-scope-v1.json\",\n+      \"raw_sha256\": \"b2f8c8db6d4c2538edf410939eaf9ce4396973d203fcd70ccb5ed1fc4164ed76\"\n+    }\n+  ],\n+  \"original_claim_record_sha256s\": {\n+    \"NOTE-WAVE8-W3-A-3-001\": \"f5d6567fe7e4114170e0ac1707a25ce646911c17d417ce88821f30b80e1a650c\",\n+    \"NOTE-WAVE8-W3-A-3-002\": \"cd1c64bd4029a270eec8e2a8861fb4ab18fb50491a4119b83babcff51369fb1e\",\n+    \"NOTE-WAVE8-W3-A-3-003\": \"44341d260d90118806a79ac52f7743a55df40765ca6d369fd390d7eb1a88185c\",\n+    \"NOTE-WAVE8-W3-A-3-004\": \"a5950f5b5c55c2920395e4c09a1822e23d06fed287b4000d320def70b88f5df8\",\n+    \"NOTE-WAVE8-W3-A-3-005\": \"f6ed381b33d3704d9ef4e376ccdb06fd9ad2694860b2d879eec782083b734c92\",\n+    \"NOTE-WAVE8-W3-A-3-006\": \"3871ad66ada3c5d698048ab011dc4cc16458ed6a7cc699cb2baeb043c76a697e\",\n+    \"NOTE-WAVE8-W3-A-3-007\": \"d70fcbbb4c580a3d729785866b08998616df8107039e76c15f6069f7b75ed292\",\n+    \"NOTE-WAVE8-W3-A-3-008\": \"76d0dd0d34d443eee66c2d5e70d722d2ed7b82bf6faff2ddb0229e5ce8b5876a\",\n+    \"NOTE-WAVE8-W3-A-3-009\": \"0f34a0b9ec3096ecab4d8530d29723e7c2f90d144966a6321240d6182913de1b\",\n+    \"NOTE-WAVE8-W3-A-3-010\": \"9a616aa5e785cfb3c538bb8bf46d7680384668c0060dd018ae7c7b8f53cd8853\",\n+    \"NOTE-WAVE8-W3-A-3-011\": \"a9d4fddd4d17eb0516c192a0778a556d0999bf319e99a1791ea4b9bd6afa190f\",\n+    \"NOTE-WAVE8-W3-A-3-012\": \"b97c1f8d9959ab3dd22cb9a8ca67841b3e4689f37dbf1da1b1528b20e2d62bfc\",\n+    \"NOTE-WAVE8-W3-A-3-013\": \"9fab03889a0b676504bb6a1e9c521ebecc0f62ccad3ac0f0bce38ea289a67794\",\n+    \"NOTE-WAVE8-W3-A-3-014\": \"af06e8224b3d2bedd5ddf8cc866cb3f869bbc3506d04245188670790d4b1b6bf\",\n+    \"NOTE-WAVE8-W3-A-3-015\": \"2e638b2934bb7d9ef528c93f85596ba3a7c652c9023a7c59544c97dd5c6ff901\",\n+    \"NOTE-WAVE8-W3-A-3-016\": \"0495ecc6d8db0e89bb756b0eccf5400723e01d48e7ed1663b05cda28d115e4fa\",\n+    \"NOTE-WAVE8-W3-A-3-017\": \"d140219a3e204b3fac52326677898e860d5fff18247aee0e6c2c9108da916f8b\",\n+    \"NOTE-WAVE8-W3-A-3-018\": \"eb812c4d5ffdffdf95cc3bf030a3740bfeacbb3489b0141a8678c282f88aaaf4\",\n+    \"NOTE-WAVE8-W3-A-3-019\": \"712b798fafb2c360aaffad25c276bb36d0df2ec3257428d77f6bd4e4d81add02\",\n+    \"NOTE-WAVE8-W3-A-3-020\": \"771d06977411a4f4f6d6603ffd2bdb0436fe9e65251dbfa42cc61e9079e26211\",\n+    \"NOTE-WAVE8-W3-A-3-021\": \"bc3f634950f9209c74b2d7e4c1c060265cd4af508f08ee9fa60b1ae63a4a7255\",\n+    \"NOTE-WAVE8-W3-A-3-022\": \"e46637e2757e1d1c175f0708fde039a869a8d02d4eb6d8959f1d7f45211f2db1\",\n+    \"NOTE-WAVE8-W3-A-3-023\": \"9370f15eee81c478197ceb26f735ed410da5e2bd0cd5bf7a800af1a42e5efe57\",\n+    \"NOTE-WAVE8-W3-A-3-024\": \"778463ccb8f949108eeee11dba4ca1eca935355c43464ee66dcf6c7bac6c308b\"\n+  },\n+  \"original_sources_sha256\": \"657dbed0bb5d37c44f1a3e5287ec7982df5f63ecf27a59faa42a621a8205b006\",\n+  \"original_claims_count\": 24,\n+  \"new_claim_id\": \"NOTE-CENSUS-V2-W3-A-3-ADD-001\",\n+  \"new_claim_record_sha256\": \"cbda752c530908064d78c96672b7772fe7f46f121228ca4d2730ca45784f9a29\",\n+  \"new_census\": {\n+    \"path\": \"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/census.json\",\n+    \"raw_sha256\": \"78570a654e5b6af56e2892dcf54681c45ce374cb9d5368f99e626ed18d74ca24\"\n+  },\n+  \"old_claims_unchanged\": true,\n+  \"original_omission_utf8_sha256\": \"5431d8c76f7e57575a52e044e2330a4d5c87f4a304d94bbb89b0a76a6a07aa96\",\n+  \"body_quote_utf8_sha256\": \"fb17f50476a1f2744df7e7fa1344528694b8f3bfe3f45337b14d5e9eb7ea339b\",\n+  \"same_actual_session\": true\n+}"},{"sha":"c059de61f2cbb74d8f6bdad5236cc58005d4a66a","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/validate.py","status":"added","additions":189,"deletions":0,"changes":189,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fvalidate.py","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fvalidate.py","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fvalidate.py?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,189 @@\n+#!/usr/bin/env python3\n+\"\"\"Focused, read-only preservation/binding validation for this source-only author packet.\"\"\"\n+import copy\n+import hashlib\n+import json\n+import subprocess\n+import unittest\n+from pathlib import Path\n+\n+PREFIX = 'reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e'\n+ROOT = Path(__file__).resolve().parents[5]\n+OLD_PATH = 'reports/full-corpus-review/body-corrections/w3-a-3-v1/census.json'\n+REPORT_PATH = 'reports/full-corpus-review/independent-notes/body-v1-c-review.json'\n+REV_PATH = 'revisions/notes/candidates/2026-11-04-w3-a-3-pamphlet-scope-v1.json'\n+NEW_ID = 'NOTE-CENSUS-V2-W3-A-3-ADD-001'\n+ACTOR = '/root/independent_case_e'\n+INSTANCE = 'gpt-independent-session-root-independent_case_e-20261103'\n+BLOCKED = 'BLOCKED_PENDING_N1_ACTIVATION_AND_NATIVE_REGISTRATION'\n+\n+def sha(raw):\n+    return hashlib.sha256(raw).hexdigest()\n+\n+def digest(value):\n+    return sha(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode())\n+\n+def load(path):\n+    return json.loads((ROOT / path).read_text())\n+\n+def validate(census=None, handoff=None, raw_overrides=None):\n+    census = load(PREFIX + '/census.json') if census is None else census\n+    handoff = load(PREFIX + '/author-handoff.json') if handoff is None else handoff\n+    raw_overrides = {} if raw_overrides is None else raw_overrides\n+    original = load(OLD_PATH)\n+    report = load(REPORT_PATH)\n+    revision = load(REV_PATH)\n+    manifest = load(PREFIX + '/preservation-manifest.json')\n+    unit = census['units'][0]\n+    new = census['claims'][-1]\n+    prior = report['records'][0]\n+    # Every original field/status/source and record order remains exactly identical.\n+    assert len(original['claims']) == 24\n+    assert census['claims'][:24] == original['claims'], 'Original24 changed'\n+    assert len(census['claims']) == 25, 'Exact25 required'\n+    assert {x['claim_id']: digest(x) for x in census['claims'][:24]} == manifest['original_claim_record_sha256s']\n+    assert {k: census['sources'][k] for k in original['sources']} == original['sources'], 'Old source metadata changed'\n+    assert len(census['sources']) == len(original['sources']) + 2\n+    assert len({x['claim_id'] for x in census['claims']}) == 25\n+    assert new['claim_id'] == NEW_ID\n+    assert all(new['statement_ko'] != x['statement_ko'] for x in original['claims']), 'Duplicate proposition'\n+    body = revision['units'][0]['body']\n+    assert sha(body.encode()) == unit['unit_content_sha256'] == 'e082d19727f6000e00d21a2c78e76405dfd406bf3f1a786242f57a1047c1ab4a'\n+    assert new['unit_content_sha256'] == unit['unit_content_sha256']\n+    assert body.count(new['statement_ko']) == 1\n+    assert new['statement_ko'] == prior['new_omission_assessments'][0]['body_quote']\n+    assert new['body_span']['utf8_sha256'] == sha(new['statement_ko'].encode())\n+    assert unit['claim_count'] == 25 and unit['source_checked_claim_count'] == 22 and unit['source_blocked_claim_count'] == 3\n+    assert new['review_status'] == 'AUTHOR_SOURCE_CHECKED' and new['independent'] is False\n+    assert new['related_question_ids'] == [] and new['related_question_alignment_status'] == 'NOT_ASSESSED'\n+    assert new['effective_date'] is None and 'UNKNOWN' in new['effective_date_note']\n+    assert census['author_provenance'] == {'actor_id': ACTOR, 'session_id': ACTOR}\n+    assert census['author_instance'] == INSTANCE == handoff['author_instance']\n+    assert set(handoff['future_independent_review_excluded_actor_ids']) == {'/root/independent_procedural_retry', ACTOR}\n+    assert {'/root/independent_procedural_retry', ACTOR}.issubset(census['known_author_ids'])\n+    assert census['candidate_body_inactive'] is True and census['current_census_ready'] is False and census['current_review_valid'] is False\n+    assert census['activation_and_registration_status'] == handoff['status'] == BLOCKED\n+    assert handoff['native_version_record_created'] is False\n+    assert handoff['native_registration_performed'] is False and handoff['body_activation_performed'] is False\n+    assert handoff['queue_ledger_generated_writes'] is False\n+    assert all(v == 0 for v in handoff['credits'].values())\n+    for key in ['canonical_release_credit', 'question_audit_credit', 'new_author_review_credit', 'new_independent_legal_audit_credit', 'new_active_body_release_credit', 'current_coverage_credit']:\n+        assert census[key] == 0\n+    assert census['canonical_audit'] is False and census['independent_of_authors'] is False\n+    assert census['independent_audit'] == {'status': 'NOT_PERFORMED_BY_THIS_AUTHOR', 'verified_units': 0, 'verified_claims': 0}\n+    assert handoff['claim_mapping'] == {x['claim_id']: [x['claim_id']] for x in original['claims']}\n+    assert handoff['added_claim_ids'] == [NEW_ID] and handoff['changed_claim_ids'] == []\n+    omission = handoff['omission_resolutions'][0]\n+    assert omission['original_omission_exact'] == prior['omissions'][0]\n+    assert omission['omission_sha256'] == sha(prior['omissions'][0].encode())\n+    assert omission['claim_ids'] == [NEW_ID]\n+    expected_hold = next(c for c in prior['claims'] if c['claim_id'] == 'NOTE-WAVE8-W3-A-3-011')\n+    hold = handoff['inherited_mandatory_legal_blockers']['NOTE-WAVE8-W3-A-3-011']\n+    assert hold['full_original_review_object'] == expected_hold, 'C011 carried object changed'\n+    assert hold['status'] == 'LEGAL_HOLD' and hold['may_clear_in_census_only_correction'] is False\n+    assert expected_hold['legal_status'] == 'LEGAL_HOLD'\n+    assert [x['claim_id'] for x in handoff['all_original_author_negative_records_preserved']] == [x['claim_id'] for x in original['claims'] if x['review_status'] == 'SOURCE_BLOCKED']\n+    queue = load('reports/full-corpus-review/independent-notes-work-queue.json')\n+    job = next(j for j in queue['jobs'] if j['job_id'] == report['job_id'])\n+    parent = handoff['parent_independent_review']\n+    assert job['status'] == 'INTEGRATED' and parent['previous_job_sha256'] == digest(job)\n+    assert parent['previous_binding'] == job['unit_bindings']['w3-a-3']\n+    assert parent['previous_report']['raw_sha256'] == '16d98bf341fc6263b26e0b6d4efc9d6b2cfc148b5639aba510248e8a77d863a3'\n+    for key in ['previous_report', 'previous_result']:\n+        item = parent[key]\n+        assert sha((ROOT / item['path']).read_bytes()) == item['raw_sha256']\n+    snapshot = load(PREFIX + '/evidence/current-root-binding-snapshot.json')\n+    assert sha(snapshot['actual_effective_unit']['body'].encode()) == snapshot['unit_row']['actual_effective_body_sha256']\n+    assert snapshot['unit_row']['actual_effective_body_sha256'] != unit['unit_content_sha256']\n+    assert snapshot['candidate_body_is_current'] is False\n+    for proof in new['authorities']:\n+        assert proof['source_type'] == 'PUBLIC_OFFICIAL'\n+        assert proof['official_url'].startswith(('https://malegislature.gov/', 'https://www.mass.gov/'))\n+        assert proof['normal_TLS_certificate_verification'] is True\n+        assert proof['law_checked_date'] == '2026-11-04'\n+        assert proof['exact_section'] and 'UNKNOWN' in proof['version_or_effective_date_status']\n+        raw = raw_overrides.get(proof['evidence_path'], (ROOT / proof['evidence_path']).read_bytes())\n+        assert sha(raw) == proof['evidence_sha256'], 'Primary payload hash mismatch'\n+        source = census['sources'][proof['source_id']]\n+        assert source['http_status'] == 200\n+        assert source['document_identity_and_legal_scope'] == 'OFFICIAL_DOCUMENT_IDENTIFIED_AND_TARGET_PROVISIONS_DIRECTLY_READ'\n+        assert proof['retrieved_at_utc'] == source['retrieved_at_utc']\n+        assert proof['read_at_utc'] == source['read_at_utc']\n+        assert sha((ROOT / source['extracted_text_path']).read_bytes()) == source['extracted_text_sha256']\n+    # Verify every protected artifact, not merely semantic statements.\n+    for item in manifest['protected_artifacts']:\n+        assert sha((ROOT / item['path']).read_bytes()) == item['raw_sha256'], 'Protected artifact modified: ' + item['path']\n+    for target in [handoff['replacement_census'], manifest['new_census']]:\n+        assert target['path'] == PREFIX + '/census.json'\n+        assert target['raw_sha256'] == sha((ROOT / target['path']).read_bytes())\n+    changed = subprocess.check_output(['git', '-C', str(ROOT), 'diff', '--name-only', manifest['source_only_base_commit']], text=True).splitlines()\n+    untracked = subprocess.check_output(['git', '-C', str(ROOT), 'ls-files', '--others', '--exclude-standard'], text=True).splitlines()\n+    assert all(p.startswith(PREFIX + '/') for p in changed + untracked), 'Path outside owned source-only prefix'\n+    return {'status': 'PASS', 'claims': 25, 'old_claims_identical': 24, 'new_atoms': 1, 'primary_payloads': 2, 'protected_artifacts': len(manifest['protected_artifacts']), 'current_coverage_credit': 0, 'registration_status': BLOCKED}\n+\n+class PreservationRefusals(unittest.TestCase):\n+    def setUp(self):\n+        self.census = load(PREFIX + '/census.json')\n+        self.handoff = load(PREFIX + '/author-handoff.json')\n+\n+    def refused(self, change):\n+        change()\n+        with self.assertRaises(AssertionError):\n+            validate(self.census, self.handoff)\n+\n+    def test_actual_packet(self):\n+        self.assertEqual(validate()['status'], 'PASS')\n+\n+    def test_original_statement_change_rejected(self):\n+        self.refused(lambda: self.census['claims'][0].update(statement_ko='changed'))\n+\n+    def test_original_source_status_clear_rejected(self):\n+        self.refused(lambda: self.census['claims'][10].update(review_status='AUTHOR_SOURCE_CHECKED'))\n+\n+    def test_original_metadata_date_change_rejected(self):\n+        self.refused(lambda: self.census['claims'][7].update(checked_at='2026-11-04'))\n+\n+    def test_old_source_mutation_rejected(self):\n+        self.refused(lambda: self.census['sources']['21'].update(effective_date='2026-11-04'))\n+\n+    def test_omitted_old_record_rejected(self):\n+        self.refused(lambda: self.census['claims'].pop(7))\n+\n+    def test_duplicate_new_atom_rejected(self):\n+        self.refused(lambda: self.census['claims'][-1].update(statement_ko=self.census['claims'][7]['statement_ko']))\n+\n+    def test_c011_legal_hold_cannot_be_cleared(self):\n+        self.refused(lambda: self.handoff['inherited_mandatory_legal_blockers']['NOTE-WAVE8-W3-A-3-011'].update(status='KEEP'))\n+\n+    def test_c011_inherited_blocker_cannot_be_edited(self):\n+        self.refused(lambda: self.handoff['inherited_mandatory_legal_blockers']['NOTE-WAVE8-W3-A-3-011']['full_original_review_object']['inherited_legal_blockers'].clear())\n+\n+    def test_inactive_cannot_be_current(self):\n+        self.refused(lambda: self.census.update(current_review_valid=True))\n+\n+    def test_no_future_version_record(self):\n+        self.refused(lambda: self.handoff.update(native_version_record_created=True))\n+\n+    def test_no_self_independent_credit(self):\n+        self.refused(lambda: self.handoff['credits'].update(independent_review_credit=1))\n+\n+    def test_author_exclusion_cannot_disappear(self):\n+        self.refused(lambda: self.handoff['future_independent_review_excluded_actor_ids'].remove(ACTOR))\n+\n+    def test_unread_question_alignment_cannot_be_claimed(self):\n+        self.refused(lambda: self.census['claims'][-1].update(related_question_ids=['MA-Q-0001']))\n+\n+    def test_primary_bytes_mismatch_rejected(self):\n+        proof = self.census['claims'][-1]['authorities'][0]\n+        with self.assertRaises(AssertionError):\n+            validate(self.census, self.handoff, {proof['evidence_path']: b'HTTP200 wrong document'})\n+\n+    def test_http200_not_document_proof(self):\n+        self.refused(lambda: self.census['sources']['census-v2-e-mgl11239d'].update(document_identity_and_legal_scope='PENDING_DIRECT_READ; HTTP200 alone is not proof'))\n+\n+    def test_parent_binding_change_rejected(self):\n+        self.refused(lambda: self.handoff['parent_independent_review']['previous_binding'].update(body_sha256='0' * 64))\n+\n+if __name__ == '__main__':\n+    print(json.dumps(validate(), ensure_ascii=False))\n+    unittest.main(verbosity=2)"},{"sha":"944649a67488b7307f1d0098a91422ca41baa9f9","filename":"reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/validation.json","status":"added","additions":44,"deletions":0,"changes":44,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fvalidation.json","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fvalidation.json","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fbody-corrections%2Fw3-a-3-v1%2Fcensus-v2-author-e%2Fvalidation.json?ref=c8e8f7b825e576887220867b322779dc5b1c8d67","patch":"@@ -0,0 +1,44 @@\n+{\n+  \"schema_version\": 1,\n+  \"validated_at_utc\": \"2026-11-04T05:51:56.746681+00:00\",\n+  \"source_commit\": \"ee74466a1b2f754b5feedb2db1d6930837c87d6f\",\n+  \"validation_command\": \"python reports/full-corpus-review/body-corrections/w3-a-3-v1/census-v2-author-e/validate.py\",\n+  \"test_exit_code\": 0,\n+  \"tests_passed\": 17,\n+  \"primary_payloads_fresh_TLS200_direct_read\": 2,\n+  \"old_claim_JSON_objects_identical\": 24,\n+  \"new_atoms\": 1,\n+  \"final_claim_count\": 25,\n+  \"protected_artifact_raw_hashes_checked\": 56,\n+  \"native_version_record_created\": false,\n+  \"native_registration_performed\": false,\n+  \"body_activation_performed\": false,\n+  \"root_queue_ledger_generated_writes\": false,\n+  \"status\": \"BLOCKED_PENDING_N1_ACTIVATION_AND_NATIVE_REGISTRATION\",\n+  \"current_coverage_credit\": 0,\n+  \"independent_review_credit\": 0,\n+  \"question_audit_credit\": 0,\n+  \"canonical_release_credit\": 0,\n+  \"validation_scr
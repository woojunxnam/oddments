 못한 법적 주장이 있습니다. 해당 주장은 확인 보류 상태입니다.\",\n+        \"report_path\": \"reports/full-corpus-review/independent-notes/wave10-followup-d-review.json\",\n+        \"report_sha256\": \"f89c02b96acf1c54670afb535676ee55492f52e9ea1e28ace29362a27f8b1fc6\",\n+        \"result_path\": \"reports/full-corpus-review/independent-notes/review-independent-notes-3675c75ad36701f4-result.json\",\n+        \"result_sha256\": \"1eebce27521a294b9219db9e426d02c8b3ffa19ef2a5eedfd59a426f7942257c\",\n+        \"body_sha256\": \"890a3e7840580c383a929271852d8c6247a8f4c908b0db4c54206640400559c0\",\n+        \"census_sha256\": \"9d2289011c30000f78eec877f311216fddcf10c6fdbbc7f166ea03700ef8d8d4\",\n+        \"actor_provenance\": {\n+          \"actor_id\": \"/root/independent_wave10_d\",\n+          \"session_id\": \"/root/independent_wave10_d\"\n+        },\n+        \"auditor_instance\": \"GPT:/root/independent_wave10_d:20261104\",\n+        \"basis\": \"INTEGRATED_CURRENT_BINDING_CONTROLLER_ATTESTED_DECLARATION\",\n+        \"question_audit_credit\": 0,\n+        \"canonical_release_credit\": 0\n+      }\n     },\n     {\n       \"unit_id\": \"ipledge-transition\","},{"sha":"dbc232aae0f87b0cc54abd4b10584d40122f804a","filename":"reports/full-corpus-review/engineering/actual-n1-recursion-20261104/actual-coupled-source-check.log","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/woojunxnam/oddments/blob/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Factual-n1-recursion-20261104%2Factual-coupled-source-check.log","raw_url":"https://github.com/woojunxnam/oddments/raw/c8e8f7b825e576887220867b322779dc5b1c8d67/reports%2Ffull-corpus-review%2Fengineering%2Factual-n1-recursion-20261104%2Factual-coupled-source-check.log","contents_url":"https://api.github.com/repos/woojunxnam/oddments/contents/reports%2Ffull-corpus-review%2Fengineering%2Factual-n1-recursion-20261104%2Factual-coupled-source-check.log?ref=c8e8f7b825e576887220867b322779
c-icon-syndication-round\"></span>\r\n+\t\t\t</a>\r\n+\t\t</div>\r\n+\t</div>\r\n+\t<div id=\"content-sources\" class=\"page-content-sources__body accordion-collapse collapse\">\r\n+\r\n+\t\t<div class=\"callout callout-content-source\" role=\"status\">\r\n+\t\t\t<div class=\"callout-heading\">Content Source:</div>\r\n+\t\t\t<a class=\"cdc-block-link\" href=\"/ncird/index.html\">National Center for Immunization and Respiratory Diseases</a>; <a class=\"cdc-block-link\" href=\"https://www.cdc.gov/ncird/divisions-offices/isd.html\">Immunization Services Division</a>\r\n+\t\t</div>\r\n+\r\n+\t\t\t</div>\r\n+</div>\r\n+\r\n+<section class=\"container related-pages related-pages__mobile\">\r\n+\t<div data-related-nav-mobile></div>\r\n+</section>\r\n+\t</div>\r\n+</main>\r\n+\r\n+<section class=\"site-footer container noindex\">\r\n+\t<div class=\"row cdc-footer__inner\">\r\n+\t\t<div class=\"col-lg-3 site-footer__heading\r\n+\t\t\thas-home-link\t\t\">\r\n+\t\t\t<h2>\r\n+\t\t\t\t<a href=\"/vaccines/index.html\" class=\"cdc-footer__super-title\" aria-label=\"Vaccines &amp; Immunizations\">\r\n+\t\t\t\t\t\t\t\t\t\t\t<i class=\"cdc-icon cdc-fa-solid cdc-fa-house\"></i>\r\n+\t\t\t\t\t\t\t\t\t\t<span>Vaccines &amp; Immunizations&nbsp;<i class=\"cdc-icon cdc-fa-light cdc-fa-angle-right\"></i></span>\r\n+\t\t\t\t</a>\r\n+\t\t\t</h2>\r\n+\t\t\t\t\t\t\t\t<p class=\"cdc-footer__site-desc\">Vaccination is one of the best things you can do to help protect yourself from serious diseases.</p>\r\n+\t\t\t\t\t\t\t\t\t\t\t<a href=\"/vaccines/site.html\" class=\"cdc-footer__all btn-outline__half btn btn-outline-white btn-arrow\">\r\n+\t\t\t\tView All\t\t\t</a>\r\n+\t\t\t\t\t</div>\r\n+\t\t<div class=\"col-lg-8 offset-lg-1\">\r\n+\t\t\t<div class=\"row site-footer__links\">\r\n+\t\t\t\t<div class=\"col-md-6\">\r\n+\t\t\t\t\t\t\t\t\t\t\t<!-- If Group Site is Enabled, Need at Least 2 Links -->\r\n+\t\t\t\t\t\t\t\t\t\t\t\t\t<h3 class=\"site-footer__links__header\">\r\n+\t\t\t\t\t\t\t\t\t\t\t\t\t
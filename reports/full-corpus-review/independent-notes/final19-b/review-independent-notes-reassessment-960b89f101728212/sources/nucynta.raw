                                 <td styleCode="Lrule Rrule">12 to &lt;18 years</td>
                                 <td styleCode="Rrule">25</td>
                                 <td styleCode="Rrule">0.406</td>
                                 <td styleCode="Rrule">53</td>
                                 <td styleCode="Rrule">0.239</td>
                                 <td styleCode="Rrule">-0.167 (-0.311, -0.022)</td>
                              </tr>
                              <tr styleCode="Botrule">
                                 <td styleCode="Lrule Rrule">6 to &lt; 12 years</td>
                                 <td styleCode="Rrule">15</td>

<script>

document.addEventListener('DOMContentLoaded', () => {
  const searchInput = document.getElementById('searchInput');
  const suggestionsList = document.getElementById('suggestionsList');
  const items = Array.from(suggestionsList.querySelectorAll('.suggestion-item'));

   const uniqueItems = [];
  const uniqueKeys = new Set();

  items.forEach(li => {
    const proprietary = (li.dataset.name || '').trim().toLowerCase();
    const proper = (li.dataset.proper || '').trim().toLowerCase();
    const bla = (li.dataset.bla || '').trim().toLowerCase();
    const license = (li.dataset.lictype || '').trim().toLowerCase();

    const key = `${proprietary}||${proper}||${bla}||{lictype}`;

   
    if(!uniqueKeys.has(key)){
      uniqueKeys.add(key);
      uniqueItems.push(li);
    }
    else{
      li.remove();
    }
  })


  suggestionsList.style.display = 'none';

  searchInput.addEventListener('input', () => {
  const query = searchInput.value.trim().toLowerCase();

    if (query.length < 3) {
      suggestionsList.style.display = 'none';
      return;
    }

    let visibleCount = 0;

    items.forEach(li => {
      const name = (li.dataset.name || '').toLowerCase();
      const proper = (li.dataset.proper || '').toLowerCase();
      const bla = (li.dataset.bla || '').toLowerCase(); 

      if (name.includes(query) || proper.includes(query) || bla.includes(query)) {
        li.style.display = 'flex';
        visibleCount++;
      } else {
        li.style.display = 'none';
      }
    });

    suggestionsList.style.display = visibleCount ? 'block' : 'none';
    applySuggestions();
    
  });

  function applySuggestions(){
  let visibleIndex = 0;
  items.forEach(li => {
    if(li.offsetParent !== null){
      li.classList.remove('odd', 'even');
      li.classList.add(visibleIndex % 2 === 0 ? 'odd' : 'even');
      visibleIndex++;
    }
    else{
      li.classList.remove('odd', 'even');
    }
  })
}
  
  document.addEventListener('click', e => {
    const clickable = e.target.closest('.clickable');
    if(!clickable) return;

    const li = clickable.closest('.suggestion-item');
    if (li) {
      const selectedName = li.dataset.name;
      const selectedProper = li.dataset.proper;
      
      let Proper = selectedProper.trim();
      let coreProper;

      if(Proper.includes('(') && Proper.includes(')')) {
        coreProper = Proper;
      }

      else if(
        Proper.split('-').length === 2 && /^[a-z]+$/.test(Proper.split('-')[1])
      )
      {
        coreProper = Proper.split('-')[0].trim();
      }
      else{
        coreProper = Proper;
      }
     
      

      localStorage.setItem('selectedName', selectedName);
      localStorage.setItem('selectedProper', selectedProper);


      window.location.href = `index.cfm?event=simplesearch&proprietary=${encodeURIComponent(selectedName)}&proper=${encodeURI(coreProper)}`;
    } else if (!suggestionsList.contains(e.target) && e.target !== searchInput) {
      suggestionsList.style.display = 'none';
    }
  });
});
</script> 
  



        


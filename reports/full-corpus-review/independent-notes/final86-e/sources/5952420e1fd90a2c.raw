        "<table width=\"100%\" styleCode=\"Noautorules\"><col width=\"80%\" align=\"left\" valign=\"top\"/><col width=\"20%\" align=\"right\" valign=\"bottom\"/><tbody><tr><td>Dosage and Administration ( <linkHtml href=\"#S2.4\">2.4</linkHtml>, <linkHtml href=\"#S2.5\">2.5</linkHtml>) </td><td>9/2024</td></tr><tr><td>Warnings and Precautions ( <linkHtml href=\"#S5.10\">5.10</linkHtml>) </td><td>1/2025</td></tr></tbody></table>"

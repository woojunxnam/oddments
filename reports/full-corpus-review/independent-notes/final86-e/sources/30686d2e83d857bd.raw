            <section ID="s2">
               <id root="5d0c11f1-f0c0-40b8-a849-9aa01b24d392"/>
               <code code="43683-2" codeSystem="2.16.840.1.113883.6.1" displayName="RECENT MAJOR CHANGES SECTION"/>
               <effectiveTime value="20250128"/>
               <excerpt>
                  <highlight>
                     <text>
                        <table width="100%" styleCode="Noautorules">

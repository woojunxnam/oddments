<tr class="First Last">
<th align="left" class="Lrule Rrule"></th><th align="center" class="Rrule" valign="bottom">SPRAVATO + Oral AD 
     <br/>  (N=227)
    </th><th align="center" class="Rrule" valign="bottom">Placebo + Oral AD 
     <br/>  (N=225)
    </th>
</tr>
</thead>

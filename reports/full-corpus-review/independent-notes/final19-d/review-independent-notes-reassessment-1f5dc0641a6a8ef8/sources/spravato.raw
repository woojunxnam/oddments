</tr>
<tr class="Botrule">
<td align="left" class="Lrule Rrule">  Myalgia</td><td align="center" class="Rrule">5 (2%)</td><td align="center" class="Rrule">1 (0.4%)</td>
</tr>
<tr class="Botrule">
<td align="left" class="Lrule Rrule" colspan="3"><span class="Bold">Nervous system disorders</span></td>
</tr>
<tr class="Botrule">
<td align="left" class="Lrule Rrule">  Dizziness
    
     <a class="Sup" href="#footnote-5">*</a></td><td align="center" class="Rrule">103 (45%)</td><td align="center" class="Rrule">34 (15%)</td>
</tr>
<tr class="Botrule">
<td align="left" class="Lrule Rrule">  Sedation
    
     <a class="Sup" href="#footnote-5">*</a></td><td align="center" class="Rrule">66 (29%)</td><td align="center" class="Rrule">27 (12%)</td>
</tr>
<tr class="Botrule">
<td align="left" class="Lrule Rrule">  Dysgeusia
    
     <a class="Sup" href="#footnote-5">*</a></td><td align="center" class="Rrule">46 (20%)</td><td align="center" class="Rrule">29 (13%)</td>
</tr>

<th align="left" class="Lrule"></th><th align="center" class="Botrule Rrule" colspan="2" valign="middle">Patients &lt;65 years</th><th align="center" class="Botrule Rrule" colspan="2" valign="middle">Patients ≥65 years</th><th align="center" class="Botrule Rrule" colspan="2">Adult patients including those ≥65 years</th>
</tr>

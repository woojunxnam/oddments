<col align="center" valign="middle" width="15%"/>
<col align="center" valign="middle" width="15%"/>
<col align="center" valign="middle" width="15%"/>
<col align="center" valign="middle" width="15%"/>
<thead>
<tr class="First Last">
<th align="center" class="Lrule Rrule" valign="bottom">Study No.</th><th align="center" class="Rrule" valign="bottom">Treatment Group
    
     <a class="Sup" href="#footnote-15" name="footnote-reference-15">*</a></th><th align="center" class="Rrule" valign="bottom">Number of Patients</th><th align="center" class="Rrule" valign="bottom">Mean Baseline Score (SD)</th><th align="center" class="Rrule" valign="bottom">LS Mean Change from Baseline to 24 hr Post First Dose (SE)</th><th align="center" class="Rrule" valign="middle">LS Mean Difference (95% CI)
    

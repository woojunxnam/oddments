<td align="left" class="Lrule Rrule">  Hypoesthesia
    
     <a class="Sup" href="#footnote-5">*</a></td><td align="center" class="Rrule">30 (13%)</td><td align="center" class="Rrule">4 (2%)</td>
</tr>
<tr class="Botrule">
<td align="left" class="Lrule Rrule">  Lethargy
    
     <a class="Sup" href="#footnote-5">*</a></td><td align="center" class="Rrule">10 (4%)</td><td align="center" class="Rrule">4 (2%)</td>
</tr>
<tr class="Botrule">

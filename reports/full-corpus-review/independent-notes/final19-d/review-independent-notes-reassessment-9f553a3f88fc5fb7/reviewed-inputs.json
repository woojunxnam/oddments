  "related_context": {
    "source_head": "648f4d64f6edc70b4b219f67f439d7a18a206f76",
    "questions": [
      {
        "source_path": "practice_expansion/2026-10-23/candidates/questions.json",
        "complete_record_sha256": "b9986290b6f860bf404ffb45efaf2c2b4389a3a8adb47804ced67992c94a086a",
        "question": {
          "question_id": "MA-EXP-0849",
          "family_id": "STO01",
          "question_type": "SBA",
          "negative_lead_in": false,
          "stem": "Case A: A medicine's current labeling requires a condition outside the pharmacy's general refrigerator or freezer ranges, but staff use the general range without checking the product.\n\nCase B: A pharmacy stores medication in a dorm-style refrigerator with a small freezer compartment inside the refrigerator and also keeps staff meals there.\n\nWhich conclusion correctly addresses Case A? Select ONE answer.",
          "choices": [
            {
              "id": "A",
              "text": "The actual product's approved storage and stability requirements must be considered rather than replaced by a general range."
            },
            {
              "id": "B",
              "text": "Unopened manufacturer expiration applies unchanged after every reconstitution or opening."
            },
            {
              "id": "C",
              "text": "A closed refrigerator door alone proves suitable medication storage."
            },
            {
              "id": "D",
              "text": "A dorm-style unit containing staff meals is compliant whenever it feels cold."
            }
          ],
          "correct_choice_ids": [
            "A"
          ],
          "explanation": {
            "core_reasoning": "일반 냉장2–8°C·냉동 범위와 개별 제품 조건을 구별한다. 적격 장비·food/beverage 분리·실제 온도관리 조건을 확인한다. 냉각 감각이나 외관으로 환경 적합성을 증명하지 않는다. 실제 처리 상태의 별도 in-use·BUD·expiry를 확인한다.",
            "choice_analysis": {
              "A": "선택해야 하는 옳은 설명. 일반 냉장2–8°C·냉동 범위와 개별 제품 조건을 구별한다.",
              "B": "선택하지 않아야 하는 잘못된 설명. 실제 처리 상태의 별도 in-use·BUD·expiry를 확인한다.\n교정된 설명: A shorter reconstituted or in-use period remains separate from the unopened product's expiration.",
              "C": "선택하지 않아야 하는 잘못된 설명. 냉각 감각이나 외관으로 환경 적합성을 증명하지 않는다.\n교정된 설명: Equipment capacity, airflow, monitoring, and maintenance matter to storage suitability.",
              "D": "선택하지 않아야 하는 잘못된 설명. 적격 장비·food/beverage 분리·실제 온도관리 조건을 확인한다.\n교정된 설명: The described dorm-style equipment and food storage do not meet the stated medication-storage conditions."
            },
            "learning_boundary": "같은 family의 네 문항은 같은 두 사례와 네 판단을 공유하는 연습 변형이다. 독립적인 네 임상 사례로 세지 않는다."
          }
        }
      },

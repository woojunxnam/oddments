                    <li class="download">Download DRUG LABEL INFO: <a download="" class="pdf"
                                                                      href="/dailymed/getFile.cfm?setid=926eb076-a4a8-45e4-91ef-411f0aa4f3ca&type=pdf"
                                                                      target="_blank" id="anch_dj_106">PDF</a>
                        <a download="" class="xml"
                           href="/dailymed/getFile.cfm?setid=926eb076-a4a8-45e4-91ef-411f0aa4f3ca&type=zip"
                           target="_blank" id="anch_dj_107">XML</a>
                    </li>
                    
                        <li class="medguide">Medication Guide: <a href="/dailymed/medguide.cfm?setid=926eb076-a4a8-45e4-91ef-411f0aa4f3ca"  target="_blank">HTML</a></li>
                    

                    <li class="print">
                        <a href="/dailymed/fda/fdaDrugXsl.cfm?setid=926eb076-a4a8-45e4-91ef-411f0aa4f3ca&type=display"

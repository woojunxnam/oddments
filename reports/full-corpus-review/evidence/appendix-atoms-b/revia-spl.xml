               <id root="5df18608-26c1-cb84-e063-6394a90ae20f"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <paragraph>. Proven clinically effective in the treatment of most athlete's foot (tinea pedis)
  <br/>
· Helps prevent most athlete's foot with daily use
  <br/>
.Relieves itching, cracking, and burning.
 </paragraph>
               </text>
               <effectiveTime value="20261016"/>
            </section>
         </component>

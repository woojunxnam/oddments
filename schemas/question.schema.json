{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woojunxnam/oddments/schemas/question.schema.json",
  "title": "MPJE Question Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "family_id",
    "area",
    "topic",
    "subtopic",
    "difficulty",
    "question_type",
    "provenance",
    "stem",
    "choices",
    "correct_choice_ids",
    "allow_zero_correct",
    "explanation",
    "rule_ids",
    "drug_ids",
    "reasoning_steps",
    "verification_status",
    "lifecycle_status",
    "last_legal_review",
    "audits",
    "duplicate_review_status",
    "independent_audit_status",
    "final_adjudication",
    "development_fixture"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^MA-Q-[0-9]{4}$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+)*$"
    },
    "area": {"type": "integer", "minimum": 1, "maximum": 4},
    "topic": {"type": "string", "minLength": 2},
    "subtopic": {"type": "string", "minLength": 2},
    "difficulty": {"enum": [3, 4, 5]},
    "question_type": {"enum": ["SBA", "SATA", "ORDERED_RESPONSE"]},
    "provenance": {"enum": ["GEN", "WEB_INSPIRED"]},
    "stem": {"type": "string", "minLength": 20},
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-E]$"},
          "text": {"type": "string", "minLength": 2}
        }
      }
    },
    "correct_choice_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-E]$"}
    },
    "allow_zero_correct": {"type": "boolean"},
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_reasoning", "choice_analysis", "related_facts", "mpje_trap"],
      "properties": {
        "core_reasoning": {"type": "string", "minLength": 20},
        "choice_analysis": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"type": "string", "minLength": 5},
          "propertyNames": {"pattern": "^[A-E]$"}
        },
        "related_facts": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 3}
        },
        "mpje_trap": {"type": "string", "minLength": 3}
      }
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(MA|FED)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
    },
    "drug_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "reasoning_steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "verification_status": {
      "enum": ["HOLD", "PRIMARY_VERIFIED", "OFFICIAL_POLICY_VERIFIED", "AUDIT_PENDING", "RELEASED"]
    },
    "lifecycle_status": {
      "enum": ["DRAFT", "SOURCE_VERIFIED", "AUTOMATED_QA_PASS", "AUDIT_PENDING", "AUDITED", "ADJUDICATED", "RELEASED", "REVIEW_REQUIRED"]
    },
    "last_legal_review": {"type": ["string", "null"], "format": "date"},
    "audits": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AUDIT-[A-Z0-9-]+$"}
    },
    "duplicate_review_status": {"enum": ["PENDING", "CLEAR", "NEEDS_REVIEW"]},
    "independent_audit_status": {"enum": ["PENDING", "PASSED", "FAILED"]},
    "final_adjudication": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "adjudicator", "date", "notes"],
          "properties": {
            "decision": {"enum": ["KEEP", "MINOR_EDIT", "MAJOR_REWRITE", "DELETE"]},
            "adjudicator": {"type": "string", "minLength": 2},
            "date": {"type": "string", "format": "date"},
            "notes": {"type": "string"}
          }
        }
      ]
    },
    "development_fixture": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"question_type": {"const": "SBA"}}},
      "then": {
        "properties": {
          "correct_choice_ids": {"minItems": 1, "maxItems": 1},
          "allow_zero_correct": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {
          "question_type": {"const": "SATA"},
          "allow_zero_correct": {"const": false}
        }
      },
      "then": {"properties": {"correct_choice_ids": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"question_type": {"const": "ORDERED_RESPONSE"}}},
      "then": {
        "properties": {
          "correct_choice_ids": {"minItems": 2},
          "allow_zero_correct": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"difficulty": {"const": 5}}},
      "then": {"properties": {"reasoning_steps": {"minItems": 3}}}
    }
  ]
}


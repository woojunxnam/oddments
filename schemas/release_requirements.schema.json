{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woojunxnam/oddments/schemas/release_requirements.schema.json",
  "title": "MPJE Release Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "legal_verification",
    "realism_review",
    "initial_batch_history_required",
    "final_adjudication_required",
    "final_decision_required"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "legal_verification": {"$ref": "#/$defs/auditRequirement"},
    "realism_review": {"$ref": "#/$defs/auditRequirement"},
    "initial_batch_history_required": {"type": "boolean"},
    "final_adjudication_required": {"type": "boolean"},
    "final_decision_required": {"enum": ["KEEP"]}
  },
  "$defs": {
    "auditRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_passes", "minimum_distinct_auditors", "distinctness_basis", "required_auditor_types"],
      "properties": {
        "minimum_passes": {"type": "integer", "minimum": 1},
        "minimum_distinct_auditors": {"type": "integer", "minimum": 1},
        "distinctness_basis": {"enum": ["AUDITOR_TYPE", "AUDITOR_INSTANCE"]},
        "required_auditor_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["GPT", "CLAUDE", "HUMAN"]}
        }
      }
    }
  }
}

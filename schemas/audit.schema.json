{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woojunxnam/oddments/schemas/audit.schema.json",
  "title": "Independent MPJE Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "auditor",
    "audit_date",
    "audit_scope",
    "review_type",
    "independent",
    "audit_status",
    "question_ids",
    "question_hashes",
    "results"
  ],
  "properties": {
    "audit_id": {"type": "string", "pattern": "^AUDIT-[A-Z0-9-]+$"},
    "auditor": {"enum": ["CLAUDE", "GPT", "HUMAN"]},
    "auditor_instance": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9._:-]*$"},
    "audit_date": {"type": "string", "format": "date"},
    "audit_scope": {"enum": ["INITIAL_BATCH", "REAUDIT"]},
    "review_type": {"enum": ["LEGAL_VERIFICATION", "REALISM_REVIEW"]},
    "independent": {"type": "boolean"},
    "audit_status": {"enum": ["FULLY_ADJUDICATED", "STRUCTURAL_TRIAGE_ONLY"]},
    "style_profile": {"$ref": "#/$defs/styleProfileDependency"},
    "question_ids": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MA-Q-[0-9]{4}$"}
    },
    "question_hashes": {
      "type": "object",
      "maxProperties": 40,
      "patternProperties": {
        "^MA-Q-[0-9]{4}$": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "results": {"type": "array", "maxItems": 40}
  },
  "allOf": [
    {
      "if": {"properties": {"audit_scope": {"const": "INITIAL_BATCH"}}},
      "then": {
        "properties": {
          "question_ids": {"minItems": 30},
          "question_hashes": {"minProperties": 30},
          "results": {"minItems": 30}
        }
      }
    },
    {
      "if": {"properties": {"audit_scope": {"const": "REAUDIT"}}},
      "then": {
        "properties": {
          "question_ids": {"minItems": 1},
          "question_hashes": {"minProperties": 1},
          "results": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"review_type": {"const": "LEGAL_VERIFICATION"}}},
      "then": {"properties": {"results": {"items": {"$ref": "#/$defs/legalResult"}}}}
    },
    {
      "if": {"properties": {"review_type": {"const": "REALISM_REVIEW"}}},
      "then": {
        "required": ["style_profile"],
        "properties": {"results": {"items": {"$ref": "#/$defs/realismResult"}}}
      }
    }
  ],
  "$defs": {
    "styleProfileDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "content_version", "content_hash"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^MPJE-MA-[A-Z0-9-]+$"},
        "content_version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "source_type", "exact_section", "official_url", "law_checked_date"],
      "properties": {
        "authority": {"type": "string"},
        "source_type": {
          "enum": [
            "MA_STATUTE",
            "MA_PROMULGATED_REGULATION",
            "MA_BOARD_POLICY",
            "MA_DCP_GUIDANCE",
            "FEDERAL_STATUTE",
            "FEDERAL_REGULATION",
            "DEA_OFFICIAL",
            "FDA_OFFICIAL",
            "OTHER_OFFICIAL"
          ]
        },
        "exact_section": {"type": "string"},
        "official_url": {"type": "string"},
        "law_checked_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "legalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Question_ID","Verdict","Severity","Existing_Answer_Correct","authorities","Problem","Proposed_Answer","Proposed_Rewrite","Proposed_Explanation"],
      "properties": {
        "Question_ID": {"type": "string", "pattern": "^MA-Q-[0-9]{4}$"},
        "Verdict": {"enum": ["KEEP", "MINOR_EDIT", "MAJOR_REWRITE", "DELETE"]},
        "Severity": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "Existing_Answer_Correct": {"enum": ["YES", "PARTIALLY", "NO", "NOT_ASSESSED"]},
        "authorities": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
        "Problem": {"type": "string"},
        "Proposed_Answer": {"type": "string"},
        "Proposed_Rewrite": {"type": "string"},
        "Proposed_Explanation": {"type": "string"}
      }
    },
    "realismResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Question_ID","Verdict","Severity","Realism_Verdict","Reviewed_Date","Criteria","Notes"],
      "properties": {
        "Question_ID": {"type": "string", "pattern": "^MA-Q-[0-9]{4}$"},
        "Verdict": {"enum": ["KEEP", "MINOR_EDIT", "MAJOR_REWRITE", "DELETE"]},
        "Severity": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "Realism_Verdict": {"enum": ["PASS", "FAIL"]},
        "Reviewed_Date": {"type": "string", "format": "date"},
        "Criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jurisprudence_reasoning","practice_plausibility","authentic_distractors","wording_not_guessable","reasoning_not_trivia","natural_rule_combination","appropriate_drug_context","distinct_from_bank","not_schedule_flashcard","public_style_without_copying"],
          "properties": {
            "jurisprudence_reasoning": {"type":"boolean"},
            "practice_plausibility": {"type":"boolean"},
            "authentic_distractors": {"type":"boolean"},
            "wording_not_guessable": {"type":"boolean"},
            "reasoning_not_trivia": {"type":"boolean"},
            "natural_rule_combination": {"type":"boolean"},
            "appropriate_drug_context": {"type":"boolean"},
            "distinct_from_bank": {"type":"boolean"},
            "not_schedule_flashcard": {"type":"boolean"},
            "public_style_without_copying": {"type":"boolean"}
          }
        },
        "Notes": {"type":"string"}
      }
    }
  }
}

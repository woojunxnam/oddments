    },
    {
      "id": "C",
      "text": "15 alprazolam units plus 15 pregabalin units"
    },
    {
      "id": "D",
      "text": "10 lorazepam units plus 10 alprazolam units"
    },
    {
      "id": "E",
      "text": "25 pregabalin units"
    }

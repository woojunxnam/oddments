  "stem": "A Massachusetts LTC facility has 120 licensed beds, so its Schedule II-V analgesic emergency-kit category is capped at 75 units. Which proposed analgesic configurations stay within that category cap? Select all that apply.",
  "choices": [
    {
      "id": "A",
      "text": "40 morphine units plus 35 hydromorphone units"
    },
    {
      "id": "B",
      "text": "20 morphine, 20 oxycodone, and 20 hydromorphone units"
    },
    {
      "id": "C",
      "text": "76 oxycodone units"
    },
    {
      "id": "D",
      "text": "45 morphine units plus 31 oxycodone units"
    },
    {
      "id": "E",
      "text": "25 morphine units plus 25 oxycodone units"
    }
  ],
  "correct_choice_ids": [
    "A",
    "B",
    "E"
  ],
  "explanation": {
    "core_reasoning": "For 120 beds, the LTC analgesic category may contain up to 75 total approved Schedule II-V analgesic units, not 75 of each drug.",
    "choice_analysis": {
      "A": "The total is exactly 75 units.",
      "B": "The total is 60 units.",
      "C": "That exceeds the 75-unit cap.",
      "D": "The 76-unit total exceeds the cap.",
      "E": "The total is 50 units."
    },
    "related_facts": [
      "The facility chooses its formulary with its pharmacy provider and need not stock the maximum."

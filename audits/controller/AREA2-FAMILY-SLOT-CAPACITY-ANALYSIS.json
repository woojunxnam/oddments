  "governance_proof": {
    "question": "Is there a universal rule that every family may contain only ONE final-bank question?",
    "answer": "NO. Disproven from the repository.",
    "evidence": [
      {
        "artifact": "schemas/question_family_matrix.schema.json",
        "shows": "Every family record REQUIRES max_questions_in_final_bank, typed {'type': 'integer', 'minimum': 1}. A per-family integer with a floor of 1, not a constant of 1."
      },
      {
        "artifact": "data/exam_style/question_family_matrix.json",
        "shows": "Actual cap distribution over 364 families: {\"1\": 26, \"2\": 250, \"3\": 88}. Only 26 families carry a cap of 1."
      },
      {
        "artifact": "scripts/validate_governance.py, validate_family_matrix",
        "shows": "Enforcement is `if released_count > maximum: report.error(... exceeds max_questions_in_final_bank)`, with `elif candidate_count > maximum` raising a WARNING only. Governed capacity per family is therefore maximum - released_count."
      },
      {
        "artifact": "tests/test_family_governance.py",
        "shows": "test_released_family_over_max_fails builds a family with maximum=2 and three released questions and asserts the error. Its helper defaults to maximum=2. test_extra_draft_candidates_only_warn confirms drafts above the cap only warn."
      },
      {
        "artifact": "scripts/batch3_inventory.py lines 117-120",
        "shows": "The repository's own capacity measure: headroom_in_existing_families = sum(max(0, max_questions_in_final_bank - released_count) for fid in families)."
      },
      {
        "artifact": "scripts/author_batch3a.py:38 and scripts/author_batch3b.py:38",
        "shows": "The Batch-3 authoring standard for a NEW family is max_questions_in_final_bank = 2. Batch 2 used 3, Batch-1 v3 used 1."
      }
    ],
    "separate_constraint": {
      "name": "max_family_repeat_in_mock",
      "artifact": "scripts/prebatch3_final_coverage_gate.py, build_mock",
      "shows": "build_mock assembles ONE 120-question mock by round-robin across families (rank 0 of every family, then rank 1, and so on) and then REPORTS max_family_repeat_in_mock = max(family_counts.values()). It is a measured property of an assembled mock, not a global cap on the bank.",
      "consequence": "A family holding k questions contributes its rank-0 question to the first mock, its rank-1 question to the second, and so on. Global family count greater than 1 is therefore fully compatible with per-mock repeat of 1."
    },
    "blueprint_derivation": {
      "artifact": "scripts/batch3_inventory.py lines 23-26 and scripts/prebatch3_final_coverage_gate.py line 44",
      "shows": "MOCK_ALLOCATION = {1: 26, 2: 40, 3: 29, 4: 25}, TARGET_SETS = 3, MOCK_SIZE = 120, and required = count * TARGET_SETS.",
      "consequence": "The 78 / 120 / 87 / 75 minima are three times the per-mock allocation. No repository artifact requires 360 distinct families. The observed cap ceiling of 3 equals TARGET_SETS, which is what lets one family serve one question to each of the three mocks without breaching per-mock repeat."
    }
  },

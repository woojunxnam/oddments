               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>each 30 mL contains: 
   <content styleCode="bold">sodium 15 mg</content>
                     </item>
                     <item>store between 20-25°C (68-77°F)</item>
                     <item>
                        <content styleCode="bold">Do not use if neck band imprinted with "TYLENOL
    <sup>®</sup> PM" or foil inner seal imprinted with "TYLENOL
    <sup>®</sup>" is broken or missing
   </content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20180619"/>
            </section>
         </component>

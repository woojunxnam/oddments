  "results": [
    {
      "section_id": "SG-CS-PRESCRIPTION-SPECIAL-RULES",
      "section_hash": "ef6e5809feee1eed5b4b21fc96eb8d08eae0e8e25ef70f0c1ce0366622e1f40f",
      "disposition": "MINOR_EDIT",
      "severity": "Medium",
      "criteria": {
        "paraphrase_fidelity": "PASS",

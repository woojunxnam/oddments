{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woojunxnam/oddments/schemas/source_signal.schema.json",
  "title": "Abstract Public Practice Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "source_id",
    "source_class",
    "topic",
    "observed_trap",
    "format_signal",
    "used_as_legal_authority",
    "contains_question_text",
    "notes"
  ],
  "properties": {
    "signal_id": {"type": "string", "pattern": "^SIGNAL-[A-Z0-9-]+$"},
    "source_id": {"type": "string", "pattern": "^SOURCE-[A-Z0-9-]+$"},
    "source_class": {"const": "PUBLIC_NON_OFFICIAL"},
    "topic": {"type": "string", "minLength": 2},
    "observed_trap": {"type": "string", "minLength": 2},
    "format_signal": {"type": "string", "minLength": 2},
    "used_as_legal_authority": {"const": false},
    "contains_question_text": {"const": false},
    "notes": {"type": "string"}
  }
}
